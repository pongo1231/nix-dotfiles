{
  patch,
  pkgs,
  lib,
  ...
}:
{
  hardware.graphics.package =
    (pkgs.mesa.override {
      galliumDrivers = [
        "d3d12"
        "iris"
        "llvmpipe"
        "radeonsi"
        "virgl"
        "zink"
        "nouveau"
      ];

      vulkanDrivers = [
        "amd"
        "gfxstream"
        "intel"
        "microsoft-experimental"
        "swrast"
        "virtio"
        "nouveau"
      ];
    }).overrideAttrs
      (prev: {
        version = "27.0-git";

        src = pkgs.fetchFromGitLab {
          domain = "gitlab.freedesktop.org";
          owner = "mesa";
          repo = "mesa";
          rev = "1c87c60187064c60a10378fa79e20debf0941f97";
          hash = "sha256-9SKb819Ctz/NLOOpEBGoseQwEdfaYjQN9t1GK2JEwo4=";
        };

        venusProtocolSrc = pkgs.fetchFromGitLab {
          domain = "gitlab.freedesktop.org";
          owner = "virgl";
          repo = "venus-protocol";
          rev = "02c03c815fd07f2237d7f1161bbafcf6a829373c";
          hash = "sha256-H4PNhoUD8lLx6x5xewMrnn3G59yvD2zrEYhxUJpuvnE=";
        };

        patches = prev.patches ++ [
          (pkgs.fetchpatch {
            url = "https://gitlab.com/evlaV/mesa/-/commit/e682bb001fc4e85ab191c1557692ebad5a4ee8af.patch";
            hash = "sha256-E5GItsdehLHxkgSUPQgfZxv67/+YVoTyMDr1738hq9Y=";
          })
          (patch /mesa/27/vendor-venus-protocol.patch)
        ];

        postPatch = (prev.postPatch or "") + ''
          # venus-protocol is a meson subproject (wrap-git) in newer mesa,
          # but nixpkgs meson uses --wrap-mode=nodownload. Vendor the
          # generated protocol headers like older mesa did instead.
          cp -r $venusProtocolSrc/templates $venusProtocolSrc/xmls $venusProtocolSrc/vkxml.py $venusProtocolSrc/vn_protocol.py .
          mkdir -p src/virtio/venus-protocol
          echo '/* This file is generated by venus-protocol. */' > banner
          python3 vn_protocol.py \
            --outdir src/virtio/venus-protocol \
            --banner banner
        '';

        mesonFlags = map (
          flag:
          if lib.hasPrefix "-Dvulkan-layers=" flag then
            "-Dvulkan-layers="
            + lib.concatStringsSep "," (
              builtins.filter (x: x != "anti-lag") (
                lib.splitString "," (lib.removePrefix "-Dvulkan-layers=" flag)
              )
            )
          else if lib.hasPrefix "-Dtools=" flag then
            # mesa 27 counts panfrost in -Dtools as an enabled panfrost
            # target, which builds the Rust kraid compiler; its xml-rs
            # crate cannot be fetched under --wrap-mode=nodownload. No
            # Mali hardware here, so drop the panfrost tools.
            "-Dtools="
            + lib.concatStringsSep "," (
              builtins.filter (x: x != "panfrost") (lib.splitString "," (lib.removePrefix "-Dtools=" flag))
            )
          else if lib.hasPrefix "-Damdgpu-virtio=" flag then
            # mesa 27 replaced the boolean amdgpu-virtio option with the
            # amd-options array. Keep LLVM (the default) and add virtio
            # when the old nixpkgs flag asked for it.
            "-Damd-options=use-llvm"
            + lib.optionalString (flag == "-Damdgpu-virtio=true") ",virtio"
          else
            flag
        ) prev.mesonFlags;
      });
}
