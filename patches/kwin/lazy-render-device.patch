+std::shared_ptr<RenderDevice> GpuManager::acquireRenderDevice(DrmDevice *dev)
+{
+    const auto existingIt = std::ranges::find_if(m_openDevices, [dev](const auto &renderDevice) {
+        return drmDevicesEqual(dev->libdrmDevice(), renderDevice->drmDevice()->libdrmDevice()) == 1;
+    });
+    if (existingIt != m_openDevices.end()) {
+        return *existingIt;
+    }
+
+    int numberOfDevices = drmGetDevices2(0, nullptr, 0);
+    if (numberOfDevices <= 0) {
+        return nullptr;
+    }
+    std::vector<drmDevicePtr> devices(numberOfDevices);
+    if (drmGetDevices2(0, devices.data(), numberOfDevices) < 0) {
+        return nullptr;
+    }
+
+    QString renderNodePath;
+    for (drmDevicePtr device : devices) {
+        if (drmDevicesEqual(dev->libdrmDevice(), device) == 1
+            && (device->available_nodes & (1 << DRM_NODE_RENDER))) {
+            renderNodePath = QString::fromUtf8(device->nodes[DRM_NODE_RENDER]);
+            break;
         }
-        qCDebug(KWIN_CORE, "Adding render device %s", qPrintable(device->drmDevice()->path()));
-        m_renderDevices.push_back(std::move(device));
-        updateCompatibilityMap();
-        Q_EMIT renderDeviceAdded(m_renderDevices.back().get());
     }
+    drmFreeDevices(devices.data(), devices.size());
+
+    if (renderNodePath.isEmpty()) {
+        return nullptr;
+    }
+
+    auto renderDevice = RenderDevice::open(renderNodePath);
+    if (!renderDevice) {
+        return nullptr;
+    }
+    qCDebug(KWIN_CORE, "Opened render device %s", qPrintable(renderDevice->drmDevice()->path()));
+    auto shared = std::shared_ptr<RenderDevice>(std::move(renderDevice));
+    m_openDevices.push_back(shared);
+    updateCompatibilityMap();
+    return shared;
 }
 
