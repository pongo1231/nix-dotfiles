+            index: 0,
+            connector: 'DP-1',
+            connectors: ['DP-1'],
+            vendor: 'SAM',
+            product: 'Odyssey G50F',
+            isBuiltin: false,
+        },
+        {
+            index: 1,
+            connector: 'eDP-1',
+            connectors: ['eDP-1'],
+            vendor: 'CSW',
+            product: 'MND508ZB1-1',
+            isBuiltin: true,
+        },
+    ]);
+});
+
+await test('mirrored monitors share one logical index and no single connector', () => {
+    const monitorInfo = monitorInfoFromConnectors({
+        index: 0,
+        connectors: ['DP-1', 'HDMI-1'],
