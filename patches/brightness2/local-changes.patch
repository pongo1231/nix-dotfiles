+    assertEqual(monitorInfo.connector, null);
+    assertDeepEqual(monitorInfo.connectors, ['DP-1', 'HDMI-1']);
+    assertEqual(monitorInfo.vendor, 'DEL');
+    assertEqual(monitorInfo.isBuiltin, false);
+});
+
+await test('an unknown connector is treated as unidentified', () => {
+    const monitorInfo = monitorInfoFromConnectors({
+        index: 2,
+        connectors: ['DP-9'],
+        lookup: () => null,
+    });
+
+    assertDeepEqual(monitorInfo, {
+        index: 2,
+        connector: 'DP-9',
+        connectors: ['DP-9'],
+        vendor: null,
+        product: null,
+        isBuiltin: false,
+    });
+});
+
+await test('hardware rows follow the connectors that are connected now', () => {
+    const attached = hardware('card0-DP-1');
+    const unplugged = {...hardware('card0-HDMI-A-1'), id: '8'};
+    const unknown = {...hardware(null), id: '9'};
+
+    const monitors = [monitor(0, 'DP-1')];
+    const kept = filterHardwareDisplays(
+        [attached, unplugged, unknown],
+        monitors,
+    );
+    assertDeepEqual(
+        kept.map((display) => display.id),
+        ['7', '9'],
+        'disconnected connector dropped, unknown connector kept',
+    );
+
+    assertDeepEqual(
+        filterHardwareDisplays([attached], []).length,
+        0,
+        'nothing stays attached without monitors',
+    );
+});
