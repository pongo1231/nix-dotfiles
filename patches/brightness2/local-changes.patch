diff --git a/src/services/display/MonitorLayout.js b/src/services/display/MonitorLayout.js
new file mode 100644
index 0000000..37f34e9
--- /dev/null
+++ b/src/services/display/MonitorLayout.js
@@ -0,0 +1,70 @@
+/**
+ * @fileoverview Logical monitors as the compositor orders them, with the
+ * connectors they are made of.
+ *
+ * `Meta.MonitorManager.get_monitors()` lists physical monitors, and its order
+ * is unrelated to the logical monitor index that `Main.layoutManager.monitors`
+ * and the brightness overlay use. Mutter's DisplayConfig exposes both in one
+ * structure, so the mapping comes from there instead of from position.
+ *
+ * The call must be asynchronous: the service lives in this process, so a
+ * synchronous call from the Shell would wait on itself.
+ */
+
+import Gio from 'gi://Gio';
+
+const BUS_NAME = 'org.gnome.Mutter.DisplayConfig';
+const OBJECT_PATH = '/org/gnome/Mutter/DisplayConfig';
+const INTERFACE = 'org.gnome.Mutter.DisplayConfig';
+const TIMEOUT_MS = 2000;
+
+/**
+ * Connectors of every logical monitor, in monitor index order.
+ *
+ * @param {[number, Array, Array]} currentState - Unpacked GetCurrentState reply.
+ * @returns {string[][]} Connectors per logical monitor.
+ */
+export function parseLogicalMonitorConnectors(currentState) {
+    const [, , logicalMonitors] = currentState;
+    return logicalMonitors.map((logicalMonitor) => {
+        const monitors = logicalMonitor[5];
+        return monitors.map((monitor) => monitor[0]);
+    });
+}
+
+/**
+ * Read the logical monitor layout from the compositor.
+ *
+ * @returns {Promise<string[][]|null>} Connectors per logical monitor, or null
+ *     when the compositor could not answer.
+ */
+export function getLogicalMonitorConnectors() {
+    return new Promise((resolve) => {
+        try {
+            Gio.DBus.session.call(
+                BUS_NAME,
+                OBJECT_PATH,
+                INTERFACE,
+                'GetCurrentState',
+                null,
+                null,
+                Gio.DBusCallFlags.NONE,
+                TIMEOUT_MS,
+                null,
+                (source, result) => {
+                    try {
+                        resolve(
+                            parseLogicalMonitorConnectors(
+                                source.call_finish(result).deep_unpack(),
+                            ),
+                        );
+                    } catch {
+                        resolve(null);
+                    }
+                },
+            );
+        } catch {
+            resolve(null);
+        }
+    });
+}
diff --git a/src/services/display/SoftwareDimming.js b/src/services/display/SoftwareDimming.js
new file mode 100644
index 0000000..c948f77
--- /dev/null
+++ b/src/services/display/SoftwareDimming.js
@@ -0,0 +1,177 @@
+/**
+ * @fileoverview Per-monitor software dimming: a black layer above the Shell's
+ * UI group darkens one output, for monitors that expose no hardware brightness
+ * (no DDC/CI access, or no backlight).
+ *
+ * This is the fallback KDE provides through KWin. It dims the rendered image,
+ * not the backlight, and it needs no device permissions.
+ */
+
+import St from 'gi://St';
+import * as Main from 'resource:///org/gnome/shell/ui/main.js';
+
+import {
+    SOFTWARE_BRIGHTNESS_MIN_RATIO,
+    SOFTWARE_DISPLAY_PREFIX,
+} from './Display.js';
+import {clamp} from '../NumberUtils.js';
+import {softwareDisplayId} from './SoftwareDisplays.js';
+
+export class SoftwareDimming {
+    #monitors = [];
+    #logger;
+    #entries = new Map();
+
+    /**
+     * @param {object} params - Dependencies.
+     * @param {import('../Log.js').Logger} [params.logger] - Troubleshooting log.
+     */
+    constructor({logger = null} = {}) {
+        this.#logger = logger;
+    }
+
+    /**
+     * Describe the monitors that are connected now. The controller resolves
+     * them asynchronously, so this is a push rather than a callback.
+     *
+     * @param {import('./SoftwareDisplays.js').MonitorInfo[]} monitors - Current logical monitors.
+     */
+    setMonitors(monitors) {
+        this.#monitors = monitors;
+        this.#reconcile();
+    }
+
+    /** Follow monitor changes and cover the monitors that need dimming. */
+    enable() {
+        Main.layoutManager.connectObject(
+            'monitors-changed',
+            () => this.#reconcile(),
+            this,
+        );
+        // The dim layers sit above the screen shield's group; hide them while
+        // the session is locked so the lock screen keeps its own brightness.
+        Main.sessionMode.connectObject(
+            'updated',
+            () => this.#reconcile(),
+            this,
+        );
+        // Rows and popups are added above the dim layer; keep dimming them.
+        Main.uiGroup.connectObject(
+            'child-added',
+            () => this.#raiseAll(),
+            this,
+        );
+        this.#reconcile();
+    }
+
+    destroy() {
+        Main.layoutManager.disconnectObject(this);
+        Main.sessionMode.disconnectObject(this);
+        Main.uiGroup.disconnectObject(this);
+        for (const {actor} of this.#entries.values()) {
+            actor.destroy();
+        }
+        this.#entries.clear();
+    }
+
+    /**
+     * Current ratio of a software display; 1 (no dimming) when unknown.
+     *
+     * @param {string} displayId - A display identifier from {@link softwareDisplayId}.
+     * @returns {number} Brightness ratio, 0 to 1.
+     */
+    getRatio(displayId) {
+        return this.#entries.get(displayId)?.ratio ?? 1;
+    }
+
+    /**
+     * Set a monitor's dimming. The overlay multiplies the image, which is what
+     * a brightness factor does, so ratio 0.5 halves the rendered luminance.
+     *
+     * @param {string} displayId - A display identifier from {@link softwareDisplayId}.
+     * @param {number} ratio - Brightness ratio, 0 to 1.
+     */
+    setBrightness(displayId, ratio) {
+        const entry = this.#entries.get(displayId);
+        if (!entry) {
+            this.#logger?.warn(`no software dim layer for ${displayId}`);
+            return;
+        }
+        entry.ratio = clamp(ratio, SOFTWARE_BRIGHTNESS_MIN_RATIO, 1);
+        this.#apply(entry);
+    }
+
+    /**
+     * Keep dimming only for the given displays. Everything else returns to
+     * full brightness, which is how a monitor leaves the fallback.
+     *
+     * @param {Set<string>} displayIds - Identifiers that keep their ratios.
+     */
+    retain(displayIds) {
+        for (const [displayId, entry] of this.#entries) {
+            if (!displayIds.has(displayId) && entry.ratio !== 1) {
+                entry.ratio = 1;
+                this.#apply(entry);
+            }
+        }
+    }
+
+    /** Create, move and remove layers so they cover the current monitors. */
+    #reconcile() {
+        const monitors = this.#monitors;
+        const active = new Set();
+        for (const monitor of monitors) {
+            if (monitor.isBuiltin) {
+                continue;
+            }
+            const displayId = softwareDisplayId(monitor);
+            active.add(displayId);
+            const entry = this.#entries.get(displayId) ?? this.#create(displayId);
+            const geometry = Main.layoutManager.monitors[monitor.index];
+            if (geometry) {
+                entry.actor.set_position(geometry.x, geometry.y);
+                entry.actor.set_size(geometry.width, geometry.height);
+            }
+            this.#apply(entry);
+        }
+        for (const [displayId, entry] of this.#entries) {
+            if (!active.has(displayId)) {
+                entry.actor.destroy();
+                this.#entries.delete(displayId);
+            }
+        }
+        this.#raiseAll();
+    }
+
+    #create(displayId) {
+        const actor = new St.Widget({
+            name: `brightness-software-dim-${displayId.slice(
+                SOFTWARE_DISPLAY_PREFIX.length,
+            )}`,
+            reactive: false,
+            can_focus: false,
+            visible: false,
+        });
+        Main.uiGroup.add_child(actor);
+        const entry = {actor, ratio: 1};
+        this.#entries.set(displayId, entry);
+        return entry;
+    }
+
+    #apply(entry) {
+        const dim = 1 - entry.ratio;
+        entry.actor.set_style(
+            `background-color: rgba(0, 0, 0, ${dim.toFixed(3)});`,
+        );
+        entry.actor.visible = dim > 0.001 && !Main.sessionMode.isLocked;
+    }
+
+    /** Keep the layers above windows, menus and Shell actors on that monitor. */
+    #raiseAll() {
+        for (const {actor} of this.#entries.values()) {
+            if (actor.get_parent() === Main.uiGroup) {
+                Main.uiGroup.set_child_above_sibling(actor, null);
+            }
+        }
+    }
+}
diff --git a/src/services/display/SoftwareDisplays.js b/src/services/display/SoftwareDisplays.js
new file mode 100644
index 0000000..e3c0586
--- /dev/null
+++ b/src/services/display/SoftwareDisplays.js
@@ -0,0 +1,151 @@
+/**
+ * @fileoverview Maps connected outputs to the software-dimming fallback: a
+ * monitor with no hardware brightness path still gets a brightness row that
+ * darkens its image instead of its backlight.
+ */
+
+import {
+    DISPLAY_FEATURES,
+    DISPLAY_KIND,
+    SOFTWARE_BRIGHTNESS_MIN_RATIO,
+    SOFTWARE_DISPLAY_PREFIX,
+} from './Display.js';
+import {clamp} from '../NumberUtils.js';
+
+/**
+ * @typedef {object} MonitorInfo
+ * @property {number} index - Monitor index used by the Shell layout.
+ * @property {string|null} connector - The connector when the logical monitor has exactly one.
+ * @property {string[]} connectors - Every connector the logical monitor is made of.
+ * @property {string|null} vendor - EDID manufacturer code such as `SAM`, if known.
+ * @property {string|null} product - Model name reported by the monitor, if known.
+ * @property {boolean} isBuiltin - Whether the monitor is a built-in panel.
+ */
+
+/**
+ * The connector without the card prefix, so DDC results (`card0-DP-1`) and
+ * Shell monitors (`DP-1`) compare equal. HDMI-A-1 is shortened like the labels
+ * do, keeping both sides consistent.
+ *
+ * @param {string|null} connector - Raw connector name.
+ * @returns {string|null} Comparable connector name, or null.
+ */
+export function connectorName(connector) {
+    if (!connector) {
+        return null;
+    }
+    return connector.replace(/^card\d+-/, '').replace(/^HDMI-A-/, 'HDMI-');
+}
+
+/**
+ * Stable identifier of a monitor's software-dimming rows. The connector keeps
+ * it stable when monitors are reordered; the index is the fallback.
+ *
+ * @param {MonitorInfo} monitor - Monitor to name.
+ * @returns {string} Identifier prefixed with {@link SOFTWARE_DISPLAY_PREFIX}.
+ */
+export function softwareDisplayId(monitor) {
+    const name = connectorName(monitor.connector) ?? `monitor-${monitor.index}`;
+    return `${SOFTWARE_DISPLAY_PREFIX}${name}`;
+}
+
+/**
+ * Describe one logical monitor from its connectors.
+ *
+ * The connectors come from the compositor's logical monitor list, which is
+ * ordered like the Shell's monitor indices; identity comes from the physical
+ * monitor that owns the connector, so no positional pairing is involved.
+ *
+ * @param {object} params - Logical monitor data.
+ * @param {number} params.index - Logical monitor index.
+ * @param {string[]} params.connectors - Connectors the logical monitor is made of.
+ * @param {(connector: string) => ({vendor: string|null, product: string|null, isBuiltin: boolean}|null)} [params.lookup] - Physical monitor lookup.
+ * @returns {MonitorInfo} Monitor record.
+ */
+export function monitorInfoFromConnectors({index, connectors, lookup = null}) {
+    const identity =
+        connectors
+            .map((connector) => lookup?.(connector) ?? null)
+            .find((candidate) => candidate !== null) ?? null;
+    return {
+        index,
+        connector: connectors.length === 1 ? connectors[0] : null,
+        connectors,
+        vendor: identity?.vendor ?? null,
+        product: identity?.product ?? null,
+        isBuiltin: identity?.isBuiltin === true,
+    };
+}
+
+/**
+ * Drop hardware displays whose connector is no longer connected. Displays
+ * without a connector name cannot be verified and are kept.
+ *
+ * @param {import('./Display.js').DisplayInfo[]} displays - Displays from the last scan.
+ * @param {MonitorInfo[]} monitors - Currently connected monitors.
+ * @returns {import('./Display.js').DisplayInfo[]} Displays still attached.
+ */
+export function filterHardwareDisplays(displays, monitors) {
+    const connected = new Set(
+        monitors
+            .flatMap((monitor) => monitor.connectors ?? [])
+            .map((connector) => connectorName(connector))
+            .filter((name) => name !== null),
+    );
+    return displays.filter((display) => {
+        const name = connectorName(display.connector);
+        return name === null || connected.has(name);
+    });
+}
+
+/**
+ * Monitors that no hardware brightness path controls. Built-in panels are
+ * skipped because they have their own backlight control, and displays that
+ * ddcutil listed with a readable brightness are already hardware-controlled.
+ *
+ * @param {object} params - Mapping inputs.
+ * @param {MonitorInfo[]} params.monitors - Monitors to consider.
+ * @param {import('./Display.js').DisplayInfo[]} params.hardwareDisplays - Displays with hardware brightness control.
+ * @param {(displayId: string) => number} params.getRatio - Current software ratio of a display, 0 to 1.
+ * @returns {import('./Display.js').DisplayInfo[]} Software display records.
+ */
+export function buildSoftwareDisplays({
+    monitors,
+    hardwareDisplays,
+    getRatio,
+}) {
+    const controlled = new Set(
+        hardwareDisplays
+            .map((display) => connectorName(display.connector))
+            .filter((name) => name !== null),
+    );
+    const displays = [];
+    for (const monitor of monitors) {
+        if (monitor.isBuiltin) {
+            continue;
+        }
+        const names = (monitor.connectors ?? [])
+            .map((connector) => connectorName(connector))
+            .filter((name) => name !== null);
+        if (names.some((name) => controlled.has(name))) {
+            continue;
+        }
+        const id = softwareDisplayId(monitor);
+        const ratio = clamp(getRatio(id), SOFTWARE_BRIGHTNESS_MIN_RATIO, 1);
+        displays.push({
+            id,
+            kind: DISPLAY_KIND.SOFTWARE,
+            monitorIndex: monitor.index,
+            manufacturer: monitor.vendor,
+            name: monitor.product,
+            connector: monitor.connector,
+            features: {
+                [DISPLAY_FEATURES.BRIGHTNESS]: {
+                    current: Math.round(ratio * 100),
+                    max: 100,
+                },
+            },
+        });
+    }
+    return displays;
+}
