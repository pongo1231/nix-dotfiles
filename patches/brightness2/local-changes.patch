+        [0, 0, 1.5, 0, true, [['eDP-1', 'CSW', 'MND508ZB1-1', 'y', 2880, 1920, {}]]],
+    ];
+    const connectors = parseLogicalMonitorConnectors([14, [], logical]);
+    assertDeepEqual(connectors, [['DP-1'], ['eDP-1']]);
+
+    const identities = new Map([
+        ['DP-1', {vendor: 'SAM', product: 'Odyssey G50F', isBuiltin: false}],
+        ['eDP-1', {vendor: 'CSW', product: 'MND508ZB1-1', isBuiltin: true}],
