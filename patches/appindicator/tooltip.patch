diff --git a/appIndicator.js b/appIndicator.js
index 809b8e6..d23acfd 100644
--- a/appIndicator.js
+++ b/appIndicator.js
@@ -610,6 +610,28 @@ export class AppIndicator extends Signals.EventEmitter {
         return this._proxy.Title;
     }
 
+    /* The SNI ToolTip property is (icon-name, icon-pixmaps, title, text), but the
+     * spec sets no precedence and some applications put junk in it (Steam sends
+     * title "r", text ":"), while others leave Title empty and describe
+     * themselves only in the ToolTip. So pick the most descriptive of the three
+     * candidates: the longest one that actually contains a letter or digit. */
+    get tooltip() {
+        const toolTip = this._proxy.ToolTip;
+        const candidates = [this.title, toolTip?.[2], toolTip?.[3]];
+
+        let best = null;
+
+        for (const candidate of candidates) {
+            if (typeof candidate !== 'string' || !/[0-9A-Za-z]/.test(candidate))
+                continue;
+
+            if (!best || candidate.length > best.length)
+                best = candidate;
+        }
+
+        return best;
+    }
+
     get id() {
         return this._proxy.Id;
     }
diff --git a/extension.js b/extension.js
index 0dc10ce..ed829cb 100644
--- a/extension.js
