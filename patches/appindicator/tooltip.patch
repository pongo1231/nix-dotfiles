         }
 
+        // destroy() unowns the bus name without firing the lost-name callback, so
+        // the watchdog would keep believing it still owns the name and
+        // _maybeEnableAfterNameAvailable() would then return early forever. After
+        // any reload -- and lock/unlock cycles reload extensions -- no watcher
+        // would ever be created again and every tray icon would disappear.
+        if (this._watchDog)
+            this._watchDog.nameAcquired = false;
+
         SettingsManager.destroy();
     }
 
