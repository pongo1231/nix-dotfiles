+
+TEST_CASE("the added filters keep their wire values", "[upscale]") {
+	// Steam writes the filter as a number into the app's X11 properties, and the
+	// control socket takes it the same way, so these values are ABI.
+	REQUIRE( uint32_t( GamescopeUpscaleFilter::FSR1LITE ) == 6 );
+	REQUIRE( uint32_t( GamescopeUpscaleFilter::LS1 ) == 7 );
+}
+
+TEST_CASE("the added filters parse by name", "[upscale]") {
+	REQUIRE( ParseUpscaleFilter( "fsr1lite" ) == GamescopeUpscaleFilter::FSR1LITE );
+	REQUIRE( ParseUpscaleFilter( "ls1" ) == GamescopeUpscaleFilter::LS1 );
+
+	// One name table backs both --filter and the scaling_filter command, and it
+	// matches exactly, so a casing slip is a startup error rather than a silent
+	// fallback to a different filter.
+	REQUIRE_FALSE( ParseUpscaleFilter( "FSR1Lite" ).has_value() );
+	REQUIRE_FALSE( ParseUpscaleFilter( "LS1" ).has_value() );
+
+	// fsr1lite is a spatial pre-pass over the layer's RGB view, so it takes any
+	// colourspace the composite handles.
+	REQUIRE( ResolveUpscaleFilter( GamescopeUpscaleFilter::FSR1LITE, GAMESCOPE_APP_TEXTURE_COLORSPACE_HDR10_PQ, false ) == GamescopeUpscaleFilter::FSR1LITE );
+
+	// ls1's network reads plain RGB, so it takes exactly the inputs cs_sgsr takes: HDR keeps
+	// FSR so the user does not silently lose sharpening, and a planar layer has no RGB view
+	// to read, so that drops to linear.
+	REQUIRE( ResolveUpscaleFilter( GamescopeUpscaleFilter::LS1, GAMESCOPE_APP_TEXTURE_COLORSPACE_SRGB, false ) == GamescopeUpscaleFilter::LS1 );
+	REQUIRE( ResolveUpscaleFilter( GamescopeUpscaleFilter::LS1, GAMESCOPE_APP_TEXTURE_COLORSPACE_HDR10_PQ, false ) == GamescopeUpscaleFilter::FSR );
+	REQUIRE( ResolveUpscaleFilter( GamescopeUpscaleFilter::LS1, GAMESCOPE_APP_TEXTURE_COLORSPACE_SCRGB, false ) == GamescopeUpscaleFilter::FSR );
+	REQUIRE( ResolveUpscaleFilter( GamescopeUpscaleFilter::LS1, GAMESCOPE_APP_TEXTURE_COLORSPACE_SRGB, true ) == GamescopeUpscaleFilter::LINEAR );
+
+	// fsr1lite finishes in the RCAS composite, so the sharpness setting applies to it. LS1
+	// deliberately does not - it blits its network output, and its own control is the variant
+	// ladder (GAMESCOPE_LS1_TYPE).
+	REQUIRE( UpscaleFilterUsesSharpness( GamescopeUpscaleFilter::FSR1LITE ) );
+	REQUIRE_FALSE( UpscaleFilterUsesSharpness( GamescopeUpscaleFilter::LS1 ) );
+}
