+// ---------------------------------------------------------------------------
+// Lossless Scaling LS1 upscaler
+//
+// LS1 is a four pass compute network: three passes at source resolution plus a
+// reconstruction pass at destination resolution. The network itself is not
+// shipable - the SPIR-V is derived from the user's own copy of Lossless Scaling
+// and loaded from disk at runtime, like the other compatibility shims do:
+//
+//   $GAMESCOPE_LS1_SHADER_DIR  overrides the directory
+//                              (default $XDG_DATA_HOME/gamescope/ls1)
+//   $GAMESCOPE_LS1_TYPE        appends /v<TYPE>, matching the LS1 "type"
+//                              setting in Lossless Scaling (default 1)
+//
+// <dir>/pass0.spv .. pass3.spv are expected to use this layout (produced by the
+// binding repack step of the extraction tool):
+//   binding 0: uniform buffer  (48 bytes, see Ls1Constants_t)
+//   binding 1: sampler
+//   binding 2: sampled image   (t0)
+//   binding 3: sampled image   (t1, reconstruction pass only)
+//   binding 4: storage image   (u0)
+//
+// The layer is sampled directly and the result written into the compositor's
+// temporary image, so no copies of either boundary are needed (copying would
+// require TRANSFER_SRC/DST on textures the compositor may not have flagged for
+// it). Image layout transitions go through the command buffer's helpers, so
+// layout tracking stays consistent with the rest of the compositor.
+// ---------------------------------------------------------------------------
+
+struct Ls1Constants_t
+{
+	uint32_t u_srcSize[2];
+	uint32_t u_srcSize2[2];
+	uint32_t u_srcOffset[2];
+	uint32_t u_hdr;
+	uint32_t u_pad0;
+	uint32_t u_dstSize[2];
+	uint32_t u_pad1[2];
+};
+static_assert( sizeof(Ls1Constants_t) == 48, "LS1 constants are 48 bytes" );
+
+namespace
+{
+struct Ls1State_t
+{
+	bool bTried = false;
+	bool bAvailable = false;
+
+	std::string sShaderDir;
+	VkShaderModule shaderModules[4] = {};
+	VkPipeline pipelines[4] = {};
+	VkDescriptorSetLayout setLayout = VK_NULL_HANDLE;
+	VkPipelineLayout pipeLayout = VK_NULL_HANDLE;
+	VkDescriptorPool descPool = VK_NULL_HANDLE;
+	VkDescriptorSet descSets[4] = {};
+	VkBuffer constantsBuffer = VK_NULL_HANDLE;
+	VkDeviceMemory constantsMemory = VK_NULL_HANDLE;
+	Ls1Constants_t *pConstants = nullptr;
+	VkSampler sampler = VK_NULL_HANDLE;
+
+	gamescope::OwningRc<CVulkanTexture> texA;
+	gamescope::OwningRc<CVulkanTexture> texB;
+	gamescope::OwningRc<CVulkanTexture> texC;
+
+	uint32_t uSrcW = 0, uSrcH = 0, uDstW = 0, uDstH = 0;
+	uint32_t uSrcFormat = 0;
+};
+}
+
+static Ls1State_t g_ls1;
+
+static std::vector<uint32_t> ls1_read_spirv( const std::string &sPath )
+{
+	FILE *pFile = fopen( sPath.c_str(), "rb" );
+	if ( !pFile )
+		return {};
+
+	fseek( pFile, 0, SEEK_END );
+	long lSize = ftell( pFile );
+	fseek( pFile, 0, SEEK_SET );
+	if ( lSize <= 0 || ( lSize % 4 ) != 0 )
+	{
+		fclose( pFile );
+		return {};
+	}
+
+	std::vector<uint32_t> code( size_t( lSize ) / 4 );
+	size_t uRead = fread( code.data(), 1, size_t( lSize ), pFile );
+	fclose( pFile );
+	if ( uRead != size_t( lSize ) )
+		return {};
+
+	return code;
+}
+
+// Resolves the directory holding pass0..3.spv. Pure filesystem, so it can also
+// be used from the command line before Vulkan exists.
+static bool ls1_resolve_shader_dir()
+{
+	std::string sBase;
+	const char *pDir = getenv( "GAMESCOPE_LS1_SHADER_DIR" );
+	if ( pDir && *pDir )
+		sBase = pDir;
+	else
+	{
+		const char *pDataHome = getenv( "XDG_DATA_HOME" );
+		const char *pHome = getenv( "HOME" );
+		if ( pDataHome && *pDataHome )
+			sBase = std::string( pDataHome ) + "/gamescope/ls1";
+		else if ( pHome && *pHome )
+			sBase = std::string( pHome ) + "/.local/share/gamescope/ls1";
+		else
+			sBase = "/usr/share/gamescope/ls1";
+	}
+
+	// The generator installs one directory per LS1 type (matching Lossless
+	// Scaling's LS1Sharpness setting), the default being v1 - so plain <base>
+	// usually has no shaders in it.
+	std::vector<std::string> candidates;
+	const char *pType = getenv( "GAMESCOPE_LS1_TYPE" );
+	if ( pType && *pType )
+		candidates.push_back( sBase + "/v" + pType );
+	candidates.push_back( sBase );
+	for ( int i = 1; i <= 4; i++ )
+		candidates.push_back( sBase + "/v" + std::to_string( i ) );
+
+	for ( const std::string &sCandidate : candidates )
+	{
+		FILE *pFile = fopen( ( sCandidate + "/pass0.spv" ).c_str(), "rb" );
+		if ( pFile )
+		{
+			fclose( pFile );
+			g_ls1.sShaderDir = sCandidate;
+			return true;
+		}
+	}
+
+	vk_log.errorf( "LS1: no shaders found (looked for pass0.spv in %s and its v1..v4 subdirectories); "
+		"the ls1 filter will fall back to linear. Generate them with "
+		"~/Projects/ls1-shaders/build-ls1-shaders.sh.", sBase.c_str() );
+	return false;
+}
+
+// Extern-visible, Vulkan-free probe so `gamescope -F ls1` can report up front
+// whether the filter is actually usable.
+const char *vulkan_ls1_shader_dir()
+{
+	if ( g_ls1.sShaderDir.empty() && !ls1_resolve_shader_dir() )
+		return nullptr;
+	return g_ls1.sShaderDir.c_str();
+}
+
+// Every failure here has to say so. Without this, a filter that cannot initialise is
+// indistinguishable from one that was never selected: the layer is simply blitted and the
+// user sees "the filter does nothing".
+static bool ls1_init_failed( const char *pszWhat )
+{
+	vk_log.errorf( "LS1: %s failed, filter unavailable - the layer will be blitted", pszWhat );
+	return false;
+}
+
+static bool ls1_init()
+{
+	if ( g_ls1.sShaderDir.empty() && !ls1_resolve_shader_dir() )
+		return false; // ls1_resolve_shader_dir said why
+
+	for ( uint32_t i = 0; i < 4; i++ )
+	{
+		std::string sPath = g_ls1.sShaderDir + "/pass" + std::to_string( i ) + ".spv";
+		std::vector<uint32_t> code = ls1_read_spirv( sPath );
+		if ( code.empty() )
+		{
+			vk_log.errorf( "LS1: could not read %s, filter unavailable", sPath.c_str() );
+			return false;
+		}
+
+		VkShaderModuleCreateInfo createInfo = {
+			.sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+			.codeSize = code.size() * sizeof( uint32_t ),
+			.pCode = code.data(),
+		};
+		if ( g_device.vk.CreateShaderModule( g_device.device(), &createInfo, nullptr, &g_ls1.shaderModules[i] ) != VK_SUCCESS )
+			return ls1_init_failed( "shader module creation" );
+	}
+
+	VkDescriptorSetLayoutBinding bindings[5] = {
+		{ .binding = 0, .descriptorType = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER, .descriptorCount = 1, .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT },
+		{ .binding = 1, .descriptorType = VK_DESCRIPTOR_TYPE_SAMPLER, .descriptorCount = 1, .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT },
+		{ .binding = 2, .descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, .descriptorCount = 1, .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT },
+		{ .binding = 3, .descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, .descriptorCount = 1, .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT },
+		{ .binding = 4, .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, .descriptorCount = 1, .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT },
+	};
+
+	VkDescriptorSetLayoutCreateInfo setLayoutInfo = {
+		.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+		.bindingCount = 5,
+		.pBindings = bindings,
+	};
+	if ( g_device.vk.CreateDescriptorSetLayout( g_device.device(), &setLayoutInfo, nullptr, &g_ls1.setLayout ) != VK_SUCCESS )
+		return ls1_init_failed( "descriptor set layout creation" );
+
+	VkPipelineLayoutCreateInfo pipeLayoutInfo = {
+		.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+		.setLayoutCount = 1,
+		.pSetLayouts = &g_ls1.setLayout,
+	};
+	if ( g_device.vk.CreatePipelineLayout( g_device.device(), &pipeLayoutInfo, nullptr, &g_ls1.pipeLayout ) != VK_SUCCESS )
+		return ls1_init_failed( "pipeline layout creation" );
+
+	for ( uint32_t i = 0; i < 4; i++ )
+	{
+		VkComputePipelineCreateInfo pipeInfo = {
+			.sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+			.stage = {
+				.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+				.stage = VK_SHADER_STAGE_COMPUTE_BIT,
+				.module = g_ls1.shaderModules[i],
+				.pName = "main",
+			},
+			.layout = g_ls1.pipeLayout,
+		};
+		if ( g_device.vk.CreateComputePipelines( g_device.device(), VK_NULL_HANDLE, 1, &pipeInfo, nullptr, &g_ls1.pipelines[i] ) != VK_SUCCESS )
+		{
+			vk_log.errorf( "LS1: compute pipeline creation failed for pass %u, filter unavailable - the layer will be blitted", i );
+			return false;
+		}
+	}
+
+	VkDescriptorPoolSize poolSizes[4] = {
+		{ .type = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER, .descriptorCount = 4 },
+		{ .type = VK_DESCRIPTOR_TYPE_SAMPLER, .descriptorCount = 4 },
+		{ .type = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, .descriptorCount = 8 },
+		{ .type = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, .descriptorCount = 4 },
+	};
+
+	VkDescriptorPoolCreateInfo poolInfo = {
+		.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
+		.maxSets = 4,
+		.poolSizeCount = 4,
+		.pPoolSizes = poolSizes,
+	};
+	if ( g_device.vk.CreateDescriptorPool( g_device.device(), &poolInfo, nullptr, &g_ls1.descPool ) != VK_SUCCESS )
+		return ls1_init_failed( "descriptor pool creation" );
+
+	VkDescriptorSetLayout setLayouts[4] = { g_ls1.setLayout, g_ls1.setLayout, g_ls1.setLayout, g_ls1.setLayout };
+	VkDescriptorSetAllocateInfo allocInfo = {
+		.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO,
+		.descriptorPool = g_ls1.descPool,
+		.descriptorSetCount = 4,
+		.pSetLayouts = setLayouts,
+	};
+	if ( g_device.vk.AllocateDescriptorSets( g_device.device(), &allocInfo, g_ls1.descSets ) != VK_SUCCESS )
+		return ls1_init_failed( "descriptor set allocation" );
+
+	VkBufferCreateInfo bufferInfo = {
+		.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+		.size = sizeof( Ls1Constants_t ),
+		.usage = VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT,
+	};
+	if ( g_device.vk.CreateBuffer( g_device.device(), &bufferInfo, nullptr, &g_ls1.constantsBuffer ) != VK_SUCCESS )
+		return ls1_init_failed( "constants buffer creation" );
+
+	VkMemoryRequirements reqs = {};
+	g_device.vk.GetBufferMemoryRequirements( g_device.device(), g_ls1.constantsBuffer, &reqs );
+
+	VkMemoryAllocateInfo memInfo = {
+		.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+		.allocationSize = reqs.size,
+		.memoryTypeIndex = uint32_t( g_device.findMemoryType( VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT, reqs.memoryTypeBits ) ),
+	};
+	if ( g_device.vk.AllocateMemory( g_device.device(), &memInfo, nullptr, &g_ls1.constantsMemory ) != VK_SUCCESS )
+		return ls1_init_failed( "constants memory allocation" );
+	g_device.vk.BindBufferMemory( g_device.device(), g_ls1.constantsBuffer, g_ls1.constantsMemory, 0 );
+	if ( g_device.vk.MapMemory( g_device.device(), g_ls1.constantsMemory, 0, sizeof( Ls1Constants_t ), 0, (void **)&g_ls1.pConstants ) != VK_SUCCESS || g_ls1.pConstants == nullptr )
+		return ls1_init_failed( "constants mapping" );
+
+	VkSamplerCreateInfo samplerInfo = {
+		.sType = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO,
+		.magFilter = VK_FILTER_LINEAR,
+		.minFilter = VK_FILTER_LINEAR,
+		.addressModeU = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+		.addressModeV = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+		.addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+		.maxLod = VK_LOD_CLAMP_NONE,
+	};
+	if ( g_device.vk.CreateSampler( g_device.device(), &samplerInfo, nullptr, &g_ls1.sampler ) != VK_SUCCESS )
+		return ls1_init_failed( "sampler creation" );
+
+	vk_log.infof( "LS1: loaded shaders from %s", g_ls1.sShaderDir.c_str() );
+	return true;
+}
+
+static gamescope::OwningRc<CVulkanTexture> ls1_create_texture( uint32_t uWidth, uint32_t uHeight, uint32_t uFormat )
+{
+	CVulkanTexture::createFlags createFlags;
+	createFlags.bSampled = true;
+	createFlags.bStorage = true;
+	createFlags.bTransferSrc = true;
+	createFlags.bTransferDst = true;
+
+	gamescope::OwningRc<CVulkanTexture> pTexture = new CVulkanTexture();
+	if ( !pTexture->BInit( uWidth, uHeight, 1u, uFormat, createFlags, nullptr ) )
+		return nullptr;
+
+	return pTexture;
+}
+
+static bool ls1_ensure_textures( CVulkanTexture *pSrc, CVulkanTexture *pDst, uint32_t uDstW, uint32_t uDstH )
+{
+	const uint32_t uSrcW = pSrc->width();
+	const uint32_t uSrcH = pSrc->height();
+	const uint32_t uSrcFormat = pSrc->format();
+
+	// Only the intermediates are cached (on the sizes and format that determine them).
+	// The descriptor sets are rewritten on every call below, because they reference the
+	// compositor's own textures: those can be recreated between frames, and a recycled
+	// address would make a pointer-keyed cache look like a hit while the image views it
+	// holds have already been destroyed.
+	const bool bNeedNewIntermediates = g_ls1.texA == nullptr
+		|| g_ls1.uSrcW != uSrcW || g_ls1.uSrcH != uSrcH
+		|| g_ls1.uDstW != uDstW || g_ls1.uDstH != uDstH
+		|| g_ls1.uSrcFormat != uSrcFormat;
+
+	if ( bNeedNewIntermediates )
+	{
+		g_ls1.texA = ls1_create_texture( uSrcW, uSrcH, DRM_FORMAT_ABGR8888 );
+		g_ls1.texB = ls1_create_texture( uSrcW, uSrcH, DRM_FORMAT_ABGR8888 );
+		g_ls1.texC = ls1_create_texture( uSrcW * 2u, uSrcH * 2u, DRM_FORMAT_ABGR16161616F );
+
+		if ( g_ls1.texA == nullptr || g_ls1.texB == nullptr || g_ls1.texC == nullptr )
+		{
+			vk_log.errorf( "LS1: failed to create intermediate textures" );
+			g_ls1.bAvailable = false;
+			return false;
+		}
+
+		g_ls1.uSrcW = uSrcW;
+		g_ls1.uSrcH = uSrcH;
+		g_ls1.uDstW = uDstW;
+		g_ls1.uDstH = uDstH;
+		g_ls1.uSrcFormat = uSrcFormat;
+	}
+
+	// passes: 0 src->A, 1 A->B, 2 B->C, 3 (C, src)->dst
+	for ( uint32_t uPass = 0; uPass < 4; uPass++ )
+	{
+		// The layer is sampled like the other scalers do it: through the sRGB
+		// view, so the hardware decodes it before the network sees it.
+		CVulkanTexture *pIn = uPass == 0 ? pSrc
+			: uPass == 1 ? g_ls1.texA.get()
+			: uPass == 2 ? g_ls1.texB.get()
+			: g_ls1.texC.get();
+		CVulkanTexture *pIn1 = uPass == 3 ? pSrc : pIn;
+		CVulkanTexture *pOut = uPass == 0 ? g_ls1.texA.get()
+			: uPass == 1 ? g_ls1.texB.get()
+			: uPass == 2 ? g_ls1.texC.get()
+			: pDst;
+
+		VkDescriptorBufferInfo bufferDesc = { .buffer = g_ls1.constantsBuffer, .offset = 0, .range = sizeof( Ls1Constants_t ) };
+		VkDescriptorImageInfo samplerDesc = { .sampler = g_ls1.sampler };
+		VkDescriptorImageInfo inDesc = { .imageView = uPass == 0 ? pSrc->srgbView() : pIn->linearView(), .imageLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL };
+		VkDescriptorImageInfo in1Desc = { .imageView = uPass == 3 ? pSrc->srgbView() : pIn1->linearView(), .imageLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL };
+		VkDescriptorImageInfo outDesc = { .imageView = pOut->linearView(), .imageLayout = VK_IMAGE_LAYOUT_GENERAL };
+
+		VkWriteDescriptorSet writes[5] = {
+			{ .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = g_ls1.descSets[uPass], .dstBinding = 0, .descriptorCount = 1, .descriptorType = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER, .pBufferInfo = &bufferDesc },
+			{ .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = g_ls1.descSets[uPass], .dstBinding = 1, .descriptorCount = 1, .descriptorType = VK_DESCRIPTOR_TYPE_SAMPLER, .pImageInfo = &samplerDesc },
+			{ .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = g_ls1.descSets[uPass], .dstBinding = 2, .descriptorCount = 1, .descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, .pImageInfo = &inDesc },
+			{ .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = g_ls1.descSets[uPass], .dstBinding = 3, .descriptorCount = 1, .descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, .pImageInfo = &in1Desc },
+			{ .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = g_ls1.descSets[uPass], .dstBinding = 4, .descriptorCount = 1, .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, .pImageInfo = &outDesc },
+		};
+		g_device.vk.UpdateDescriptorSets( g_device.device(), 5, writes, 0, nullptr );
+	}
+
+	return true;
+}
+
+// Copies the layer into our own texture, runs the four passes and copies the
+// result into pDst. Returns false if LS1 is unavailable for this frame.
+static bool ls1_upscale( CVulkanCmdBuffer *pCmdBuffer, CVulkanTexture *pSrc, CVulkanTexture *pDst, uint32_t uDstW, uint32_t uDstH )
+{
+	if ( !g_ls1.bTried )
+	{
+		g_ls1.bTried = true;
+		g_ls1.bAvailable = ls1_init();
+	}
+
+	if ( !g_ls1.bAvailable )
+		return false;
+
+	const uint32_t uSrcW = pSrc->width();
+	const uint32_t uSrcH = pSrc->height();
+
+	if ( !ls1_ensure_textures( pSrc, pDst, uDstW, uDstH ) )
+		return false;
+
+	g_ls1.pConstants->u_srcSize[0] = uSrcW;
+	g_ls1.pConstants->u_srcSize[1] = uSrcH;
+	g_ls1.pConstants->u_srcSize2[0] = uSrcW;
+	g_ls1.pConstants->u_srcSize2[1] = uSrcH;
+	g_ls1.pConstants->u_srcOffset[0] = 0;
+	g_ls1.pConstants->u_srcOffset[1] = 0;
+	g_ls1.pConstants->u_hdr = 0;
+	g_ls1.pConstants->u_pad0 = 0;
+	g_ls1.pConstants->u_dstSize[0] = uDstW;
+	g_ls1.pConstants->u_dstSize[1] = uDstH;
+	g_ls1.pConstants->u_pad1[0] = 0;
+	g_ls1.pConstants->u_pad1[1] = 0;
+
+	// LS1's intermediates move ~80 B per source pixel, so a large source is expensive;
+	// say so once instead of silently costing frames.
+	static bool s_bWarnedLargeSource = false;
+	if ( !s_bWarnedLargeSource && uSrcW > 1600 )
+	{
+		s_bWarnedLargeSource = true;
+		vk_log.infof( "LS1: source is %ux%u - LS1 moves ~80 B/source-pixel through its "
+			"intermediates, so FSR/NIS are the better choice at this size", uSrcW, uSrcH );
+	}
+
+	// The layer is sampled directly rather than copied first: copying needed
+	// TRANSFER_SRC/DST on the compositor's textures, which they may not have.
+	pCmdBuffer->prepareSrcImage( pSrc );
+
+	VkCommandBuffer vkCmd = pCmdBuffer->rawBuffer();
+
+	for ( uint32_t uPass = 0; uPass < 4; uPass++ )
+	{
+		g_device.vk.CmdBindPipeline( vkCmd, VK_PIPELINE_BIND_POINT_COMPUTE, g_ls1.pipelines[uPass] );
+		g_device.vk.CmdBindDescriptorSets( vkCmd, VK_PIPELINE_BIND_POINT_COMPUTE, g_ls1.pipeLayout, 0, 1, &g_ls1.descSets[uPass], 0, nullptr );
+
+		// The texture this pass samples has to be readable, the one it writes has to be writable.
+		pCmdBuffer->prepareSrcImage( uPass == 0 ? pSrc
+			: uPass == 1 ? g_ls1.texA.get()
+			: uPass == 2 ? g_ls1.texB.get()
+			: g_ls1.texC.get() );
+		if ( uPass == 3 )
+			pCmdBuffer->prepareSrcImage( pSrc );
+
+		pCmdBuffer->prepareDestImage( uPass == 0 ? g_ls1.texA.get()
+			: uPass == 1 ? g_ls1.texB.get()
+			: uPass == 2 ? g_ls1.texC.get()
+			: pDst );
+		pCmdBuffer->insertBarrier();
+
+		uint32_t uGroupsX, uGroupsY;
+		if ( uPass < 3 )
+		{
+			uGroupsX = div_roundup( uSrcW, 16u );
+			uGroupsY = div_roundup( uSrcH, 16u );
+		}
+		else
+		{
+			uGroupsX = div_roundup( uDstW, 16u );
+			uGroupsY = div_roundup( uDstH, 16u );
+		}
+
+		g_device.vk.CmdDispatch( vkCmd, uGroupsX, uGroupsY, 1 );
+		pCmdBuffer->insertBarrier();
+	}
+
+	// Pass 3 wrote straight into the compositor's tmp image; tell it the
+	// contents changed so the following composite pass re-transitions it.
+	pCmdBuffer->markDirty( pDst );
+
+	return true;
+}
