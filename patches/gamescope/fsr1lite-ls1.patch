+#version 460
+
+#extension GL_GOOGLE_include_directive : require
+#extension GL_EXT_scalar_block_layout : require
+
+#include "descriptor_set.h"
+
+#define A_GPU 1
+#define A_GLSL 1
+#include "ffx_a.h"
+
+// FSR1 "lite"/optimized upscale pass: the same role as cs_easu.comp, but instead of
+// the EASU directional 12-tap filter it resamples with a single bilinear fetch. That
+// is the cheapest kernel that keeps the geometry exact, and the sharpening this mode
+// is known for comes from the RCAS composite pass that follows it - the structure
+// Lossless Scaling's "Optimized Version"/FSR Lite and Proton's WINE_FULLSCREEN_FSR=lite
+// use (a cheap upscale pass plus RCAS) rather than full EASU.
+
+layout(
+  local_size_x = 64,
+  local_size_y = 1,
+  local_size_z = 1) in;
+
+layout(binding = 0, scalar)
+uniform push_t {
+    uvec2 u_dstSize;
+};
+
+void litePass(uvec2 pos)
+{
+    // Sample the source at this destination pixel's centre, in destination-relative
+    // coordinates: srcSize/dstSize/srcSize collapses to 1/dstSize, so this needs no
+    // division by the source size and no scale vector. One bilinear fetch keeps the
+    // geometry exact - no half-texel shift, and a 1:1 scale reproduces the source
+    // sample for sample.
+    vec2 uv = (vec2(pos) + 0.5) / vec2(u_dstSize);
+
+    vec4 color = texture(s_samplers[0], uv);
+
+    imageStore(dst, ivec2(pos), vec4(color.rgb, 1.0));
+}
+
+void main()
+{
+    // Same swizzle as the other scalers: 4 pixels per invocation.
+    uvec2 pos = ARmp8x8(gl_LocalInvocationID.x) + uvec2(gl_WorkGroupID.x << 4u, gl_WorkGroupID.y << 4u);
+    litePass(pos);
+    pos.x += 8u;
+    litePass(pos);
+    pos.y += 8u;
+    litePass(pos);
+    pos.x -= 8u;
+    litePass(pos);
+}
