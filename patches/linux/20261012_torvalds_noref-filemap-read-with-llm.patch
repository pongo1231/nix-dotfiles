From 4a130e1af84808e58a7907e4afb7dc7d0dc40a18 Mon Sep 17 00:00:00 2001
From: Linus Torvalds <torvalds@linux-foundation.org>
Date: Sat, 10 Oct 2026 01:19:37 +0200
Subject: [PATCH 7/9] mm: expedite the grace period when a CPU has many
 deferred frees

A folio whose free is deferred waits one to two grace periods on a
per-CPU list, where the allocator does not see it.  The memory on the
lists is the rate of deferred frees times that wait, which is 20 to
25 ms on an 8-CPU laptop.  Four processes that fallocate() and
hole-punch 64 MiB of a memfd in a loop free 23.7 GiB/s there and keep
565 MiB waiting on average, 1.2 GiB at the peak.  Kiryl Shutsemau
reported that this loop, next to a process that touches 1400 MiB of
anonymous memory, ends in an OOM kill.

Count the pages on each CPU's pending list.  When a free takes the
count above RCU_FREE_EXPEDITE pages, queue a work item that takes the
list, calls synchronize_rcu_expedited() and frees it.  Only that work
waits for the grace period: the task that frees does not, and neither
does reclaim.

The batch whose grace period is already in flight stays with its
callback, so nothing changes for the existing work.

The limit is a guess, and the allocator still does not see what is
below it on each CPU.  Measurements are in the last patch of the
series.

Reported-by: Kiryl Shutsemau <kirill@shutemov.name>
Assisted-by: LLM
Signed-off-by: Linus Torvalds <torvalds@linux-foundation.org>
---
 mm/page_alloc.c | 47 +++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 47 insertions(+)

diff --git a/mm/page_alloc.c b/mm/page_alloc.c
index 773b31f0c..bb67b653d 100644
--- a/mm/page_alloc.c
+++ b/mm/page_alloc.c
@@ -1334,14 +1334,24 @@ static inline void pgalloc_tag_sub_pages(struct alloc_tag *tag, unsigned int nr)
  * Reclaim makes progress only when these frees complete, so the work must
  * not wait for a new worker: the workqueue is WQ_MEM_RECLAIM.
  *
+ * The allocator does not see the folios on these lists, and a CPU that
+ * frees faster than grace periods end can put any amount of memory here.
+ * So @nr_pending counts the pages on @pending, and above
+ * RCU_FREE_EXPEDITE the CPU queues @expedite, which takes @pending and
+ * runs an expedited grace period for it.
+ *
  * rcu_free_init() runs before vfs_caches_init(), so before anything can
  * be mounted: no folio is in a page cache until the workqueue exists.
  */
+#define RCU_FREE_EXPEDITE	1024
+
 struct rcu_free_pcpu {
 	spinlock_t lock;
 	struct list_head pending;
 	struct list_head batch;
+	unsigned long nr_pending;
 	struct rcu_work rwork;
+	struct work_struct expedite;
 };
 static DEFINE_PER_CPU(struct rcu_free_pcpu, rcu_free_pcpu) = {
 	.lock = __SPIN_LOCK_UNLOCKED(rcu_free_pcpu.lock),
@@ -1356,6 +1366,7 @@ static void rcu_free_start(struct rcu_free_pcpu *r)
 		return;
 
 	list_splice_init(&r->pending, &r->batch);
+	r->nr_pending = 0;
 	if (!list_empty(&r->batch))
 		WARN_ON_ONCE(!queue_rcu_work(rcu_free_wq, &r->rwork));
 }
@@ -1395,6 +1406,38 @@ static void rcu_free_workfn(struct work_struct *work)
 	rcu_free_pages(&done);
 }
 
+/*
+ * Take @pending and free it after an expedited grace period, which starts
+ * once the folios are off the list.  Only this work waits for it.
+ *
+ * @batch is left alone: its grace period is in flight and @rwork frees it.
+ */
+static void rcu_free_expedite_workfn(struct work_struct *work)
+{
+	struct rcu_free_pcpu *r = container_of(work, struct rcu_free_pcpu,
+					       expedite);
+	LIST_HEAD(list);
+
+	spin_lock_irq(&r->lock);
+	list_splice_init(&r->pending, &list);
+	r->nr_pending = 0;
+	spin_unlock_irq(&r->lock);
+
+	/* @rwork got there first and moved @pending to @batch */
+	if (list_empty(&list))
+		return;
+
+	synchronize_rcu_expedited();
+	rcu_free_pages(&list);
+}
+
+static void rcu_free_expedite(struct rcu_free_pcpu *r, unsigned long limit)
+{
+	/* Unlocked: a stale @nr_pending moves the expedite by one free */
+	if (data_race(r->nr_pending) > limit && !work_pending(&r->expedite))
+		queue_work(rcu_free_wq, &r->expedite);
+}
+
 static void rcu_free_defer(struct folio *folio)
 {
 	struct rcu_free_pcpu *r = raw_cpu_ptr(&rcu_free_pcpu);
@@ -1402,8 +1445,11 @@ static void rcu_free_defer(struct folio *folio)
 
 	spin_lock_irqsave(&r->lock, flags);
 	list_add_tail(&folio->lru, &r->pending);
+	r->nr_pending += folio_nr_pages(folio);
 	rcu_free_start(r);
 	spin_unlock_irqrestore(&r->lock, flags);
+
+	rcu_free_expedite(r, RCU_FREE_EXPEDITE);
 }
 
 static void __init rcu_free_init(void)
@@ -1418,6 +1464,7 @@ static void __init rcu_free_init(void)
 		INIT_LIST_HEAD(&r->pending);
 		INIT_LIST_HEAD(&r->batch);
 		INIT_RCU_WORK(&r->rwork, rcu_free_workfn);
+		INIT_WORK(&r->expedite, rcu_free_expedite_workfn);
 	}
 }
 

From e69e58a909381aec305fc793625f52ec427f74e2 Mon Sep 17 00:00:00 2001
From: Linus Torvalds <torvalds@linux-foundation.org>
Date: Sat, 10 Oct 2026 01:20:45 +0200
Subject: [PATCH 8/9] mm: make way for the expedite work in the page cache
 removal loops

The expedite work runs on the CPU of the task whose frees queued it.
With lazy preemption that task keeps the CPU until the next tick: the
wakeup of the kworker sets TIF_NEED_RESCHED_LAZY, and cond_resched()
does nothing.  With one hole-punching process the work waits 0.84 ms
to start and spends 0.53 ms in synchronize_rcu_expedited(), and the
process goes on freeing all the while.

Add rcu_free_cond_resched() next to the cond_resched() of the loops in
truncate_inode_pages_range(), mapping_try_invalidate(),
invalidate_inode_pages2_range() and shmem_undo_range(): if a lazy
reschedule is pending, call schedule().  This is what cond_resched()
does there without lazy preemption.  A task that has not been asked to
make way keeps the CPU.

With that the work starts after 20 us and spends 24 us in
synchronize_rcu_expedited().

Memory waiting for a grace period, mean in MiB, while N processes
fallocate() and hole-punch 64 MiB of a memfd each in a loop, on 8 CPUs
(i7-8565U), without and with this patch and the previous one:

   N   without   with
   1     148      6.6
   4     565       15
   8     503       70
  16     540      177

At N = 4 the processes fill and free 23.5 GiB/s with the two patches
and 23.7 without, and the work runs 4600 times a second.  The table
was measured on these two patches with a counter added, the times on
an earlier build with timing added.

An unbound workqueue gets the work started as fast while a CPU is
idle, and changes nothing at N = 8 and 16, where none is.

This puts a reschedule point back where lazy preemption took one out,
and it acts on any lazy reschedule request, not only on the one the
expedite work caused.  Whether that is acceptable is a question for
the scheduler maintainers.  Reclaim's loops are not changed.

Assisted-by: LLM
Signed-off-by: Linus Torvalds <torvalds@linux-foundation.org>
