index 2628ccda0..7623a6525 100644
--- a/include/linux/vm_event_item.h
+++ b/include/linux/vm_event_item.h
@@ -36,6 +36,7 @@ enum vm_event_item { PGPGIN, PGPGOUT, PSWPIN, PSWPOUT,
 		FOR_ALL_ZONES(ALLOCSTALL)
 		FOR_ALL_ZONES(PGSCAN_SKIP)
 		PGFREE, PGACTIVATE, PGDEACTIVATE, PGLAZYFREE,
+		PGFREE_RCU, PGFREE_RCU_DONE, PGFREE_RCU_SKIP,
 		PGFAULT, PGMAJFAULT,
 		PGLAZYFREED,
 		PGREUSE,
diff --git a/mm/internal.h b/mm/internal.h
index e99e44827..abfaf67da 100644
--- a/mm/internal.h
+++ b/mm/internal.h
@@ -655,8 +655,10 @@ static inline void folio_mark_removed_from_cache(struct address_space *mapping,
 {
 	if (folio_test_hugetlb(folio))
 		return;
-	if (mapping->host && (inode_state_read_once(mapping->host) & I_FREEING))
