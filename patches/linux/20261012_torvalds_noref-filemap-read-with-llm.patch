--- a/mm/folio.c
+++ b/mm/folio.c
@@ -400,7 +400,34 @@ EXPORT_SYMBOL(folio_mark_accessed);
 EXPORT_SYMBOL(folio_mark_accessed);
 
+#ifdef CONFIG_LRU_GEN
+/*
+ * Whether folio_mark_accessed()'s LRU-gen path would leave @folio unchanged.
+ *
+ * Derived from this tree's folio_inc_lru_refs() (mm/vmscan.c, from the mm-new queue),
+ * not the old lru_gen_inc_refs() the upstream predicate mirrored: with flags == 0 that
+ * function writes the refs count unless it is already saturated, and takes an early out
+ * only for an unaccounted generation or one that is already the newest.  Only the
+ * flags-only subset is answerable without a lruvec lookup.
+ */
+static bool lru_gen_refs_full(struct folio *folio)
+{
+	unsigned long old_flags = READ_ONCE(*folio_flags(folio, 0));
+
+	if (folio_test_unevictable(folio))
+		return true;
+	if (lru_get_refs_flags(old_flags) < LRU_REFS_MAX)
+		return false;
+	return lru_get_gen_flags(old_flags) < 0;
+}
+#else
+static bool lru_gen_refs_full(struct folio *folio)
+{
+	return false;
+}
+#endif
+
