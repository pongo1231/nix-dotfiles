From bbb42039611d46f1dd7aa2d93a2698722d319953 Mon Sep 17 00:00:00 2001
From: Linus Torvalds <torvalds@linux-foundation.org>
Date: Wed, 7 Oct 2026 02:32:39 +0200
Subject: [PATCH 4/9] splice: don't steal page cache folios

page_cache_pipe_buf_try_steal() takes a folio out of the page cache with
remove_mapping() and gives it to the caller to reuse.
fuse_try_move_folio() puts it into a fuse file's page cache, where
writes to that file change it.

PG_rcu_free keeps the memory of a removed folio from being reallocated
before a lockless lookup's rcu_read_unlock(), but a stolen folio is not
freed at all.  The lockless read in the next patch holds no reference,
so it could copy the new owner's data out of a folio that it found
before the steal.  A reader that holds a reference is safe: the freeze
in remove_mapping() fails.

Drop ->try_steal from page_cache_pipe_buf_ops.  pipe_buf_try_steal() then
fails for page cache buffers, and its callers, fuse_try_move_folio() and
pipe_to_sg() in virtio_console, copy the data instead, as they already
do when stealing fails.  What is lost is SPLICE_F_MOVE of page cache
pages into a fuse file without a copy.  page_cache_pipe_buf_release()
still clears PIPE_BUF_FLAG_LRU: user_page_pipe_buf_ops uses it as well,
and user_page_pipe_buf_try_steal() sets the flag.

The remaining ->try_steal implementations take a page only when the
pipe holds its only reference.  A page cache page gets into that state
only after it has left i_pages: vmsplice(SPLICE_F_GIFT) of a mapped file
page, then a truncate.  It then has PG_rcu_free, and fuse_check_folio()
refuses it, but only because the flag is not in its list of allowed
flags, and with a dump_page().  That needs an explicit test, which is
not in this patch.

Assisted-by: LLM
Signed-off-by: Linus Torvalds <torvalds@linux-foundation.org>
---
 fs/splice.c | 51 ---------------------------------------------------
 1 file changed, 51 deletions(-)

diff --git a/fs/splice.c b/fs/splice.c
index 9d8f63e2f..0133c2348 100644
--- a/fs/splice.c
+++ b/fs/splice.c
@@ -55,56 +55,6 @@ static noinline void pipe_clear_nowait(struct file *file)
 	} while (!try_cmpxchg(&file->f_mode, &fmode, fmode & ~FMODE_NOWAIT));
 }
 
-/*
- * Attempt to steal a page from a pipe buffer. This should perhaps go into
- * a vm helper function, it's already simplified quite a bit by the
- * addition of remove_mapping(). If success is returned, the caller may
- * attempt to reuse this page for another destination.
- */
-static bool page_cache_pipe_buf_try_steal(struct pipe_inode_info *pipe,
-		struct pipe_buffer *buf)
-{
-	struct folio *folio = page_folio(buf->page);
-	struct address_space *mapping;
-
-	folio_lock(folio);
-
-	mapping = folio_mapping(folio);
-	if (mapping) {
-		WARN_ON(!folio_test_uptodate(folio));
-
-		/*
-		 * At least for ext2 with nobh option, we need to wait on
-		 * writeback completing on this folio, since we'll remove it
-		 * from the pagecache.  Otherwise truncate wont wait on the
-		 * folio, allowing the disk blocks to be reused by someone else
-		 * before we actually wrote our data to them. fs corruption
-		 * ensues.
-		 */
-		folio_wait_writeback(folio);
-
-		if (!filemap_release_folio(folio, GFP_KERNEL))
-			goto out_unlock;
-
-		/*
-		 * If we succeeded in removing the mapping, set LRU flag
-		 * and return good.
-		 */
-		if (remove_mapping(mapping, folio)) {
-			buf->flags |= PIPE_BUF_FLAG_LRU;
-			return true;
-		}
-	}
-
-	/*
-	 * Raced with truncate or failed to remove folio from current
-	 * address space, unlock and return failure.
-	 */
-out_unlock:
-	folio_unlock(folio);
-	return false;
-}
-
 static void page_cache_pipe_buf_release(struct pipe_inode_info *pipe,
 					struct pipe_buffer *buf)
 {
@@ -155,7 +105,6 @@ error:
 const struct pipe_buf_operations page_cache_pipe_buf_ops = {
 	.confirm	= page_cache_pipe_buf_confirm,
 	.release	= page_cache_pipe_buf_release,
-	.try_steal	= page_cache_pipe_buf_try_steal,
 	.get		= generic_pipe_buf_get,
 };
 

From 88f0c6cbc4edb798df8a87ed8a53f70c58ce6a4b Mon Sep 17 00:00:00 2001
From: Linus Torvalds <torvalds@linux-foundation.org>
Date: Wed, 7 Oct 2026 02:32:40 +0200
Subject: [PATCH 5/9] mm/filemap: read from the page cache without folio
 references

filemap_read() takes and drops a reference on every folio it copies
from, and small reads of one file from many CPUs contend on the
refcount.

A folio removed from the page cache is now freed only after an RCU grace
period, and the one place found that gave a removed folio to a new owner
without freeing it is gone (the previous patch).  So a page that
xas_load() finds in i_pages under rcu_read_lock() holds the file's data
until rcu_read_unlock().  Before the slow path, copy from such pages
straight to the destination, with user page faults disabled.  That is
what the slow path's reference gives it from the lookup to the end of
the copy.  Earlier proposals for a read without references copied into
an on-stack buffer and looked the folio up again afterwards; neither is
needed here.

Numbers from a laptop, an i7-8565U: 4 cores, 8 threads, one die.
16-byte pread() at offset 0 of a one-page file on ext4, every thread
with its own file descriptor, 5 second runs:

                        reads/s   kernel cycles   kernel instructions
                                    per read           per read
  1 thread,  before    7.9-8.1 M    452-454              973
  1 thread,  after       8.8 M      408-411              873
  8 threads, before   9.9-10.4 M   2937-2975           988-989
  8 threads, after     31-33 M      719-722              864

"Before" is 0f2732620d6e: the base of this series plus six pulls of
fixes, none of them in mm/ or fs/.  The laptop throttles on
temperature, which moves reads per second between runs by more than it
moves cycles per read.

So at 8 threads: three times the reads, for a quarter of the cycles.
Four threads on four cores cost 420-451 cycles per read (before:
1318-1401) and four threads on two cores 734 (before: 1081-1109), so
what remains at 8 threads is two hyperthreads sharing a core.  Eight
threads that each read a file of their own, and so share no folio, cost
827 cycles per read before and 728-729 after.

The laptop has all its cores on one die, sharing one L3, and the
difference is not a subtle one even there.  The cost removed is the
refcount's cache line moving between the CPUs that read the file, so a
machine with more CPUs, or with more than one socket, should gain more.
That is an expectation: nothing bigger than this laptop has been
measured.

The cost: a read into a user page that is not present takes the fault
with page faults disabled, fails, and takes it again in the slow path,
one extra exception per read().  A 16-byte read into such a page costs
6701-6720 cycles, against 4117-4188 before; a 64 KiB read that takes 16
faults costs 60485-60870, against 57478-58073.

Reads larger than a page stay in the fast path.  One thread, kernel
instructions and cycles per read: 64 KiB 4201-4202 and 7223-7646,
against 4424-4425 and 7334-7346 before; 1 MiB 64586-64665 and
161954-167126, against 60900-60948 and 166544-171752.  Eight threads
reading 64 KiB of one file: 11037-11096 cycles, against 17948-18051.
1 MiB reads from 8 threads are left out: their cycle counts followed
the clock the CPUs ran at, which differed between runs.

The exceptions to the deferred free do not reach filemap_read(): the
file in the iocb holds the reference to the inode that keeps I_FREEING
clear, hugetlbfs has its own read, and the swap cache is not read
through a file.

Copy one page at a time, each looked up in i_pages.  Without a reference
a concurrent split can rewrite the order that folio_size() reads, so
only the page at the looked-up index is known to belong to the folio.
The checks of the folio's flags are made once per folio, when the folio
differs from that of the previous page.

Page faults are disabled for the whole RCU read section, because a fault
cannot sleep there, and the copy is copy_page_to_iter(), as in the slow
path.  It is not copy_page_to_iter_nofault(): that one ends in
copy_to_user_nofault(), which runs the hardened usercopy check.
check_heap_object() loads the page's compound head and then compares the
copy with page_size() of that head; a split that runs between the two
loads gives it the old head with the new, smaller size, and
usercopy_abort().  copy_page_to_iter() has page_copy_sane() instead,
which returns before it reads the order for a copy within one page.

The fast path is not used when the architecture needs
flush_dcache_folio() and the mapping is writably mapped:
flush_dcache_folio() has not been checked for a folio without a
reference (arm's writes folio->flags).

Copy in batches of up to FOLIO_BATCH_SIZE pages under rcu_read_lock(),
with rcu_read_unlock() and cond_resched() between batches, to bound the
time in one read-side critical section.  Each batch starts without a
previous folio, since after rcu_read_unlock() a different folio can be
at the same address, and tests mapping_writably_mapped() again, as the
slow path does for each of its batches.

The fast path stops, and the slow path continues from there, at a user
fault, at EOF, at a folio that is missing, not uptodate, or marked for
readahead or dropbehind, and at a folio that folio_mark_accessed() would
change, because that needs a reference.  It also stops at a fatal
signal, tested between batches; filemap_get_pages() then stops the slow
path too, and the read returns what was copied.

Like the slow path, it does not call folio_mark_accessed() for the folio
the previous read ended in, and the end of a batch counts as the end of
a read for this, as it does in the slow path.
folio_mark_accessed_noop() tells from the flags alone whether
folio_mark_accessed() would change anything.

Assisted-by: LLM
Signed-off-by: Linus Torvalds <torvalds@linux-foundation.org>
---
 mm/filemap.c  | 143 ++++++++++++++++++++++++++++++++++++++++++++++++++
 mm/folio.c    |  32 +++++++++++
 mm/internal.h |   1 +
 3 files changed, 176 insertions(+)

diff --git a/mm/filemap.c b/mm/filemap.c
index 0d2bbf435..206583191 100644
--- a/mm/filemap.c
+++ b/mm/filemap.c
@@ -2780,6 +2780,139 @@ static void filemap_end_dropbehind_read(struct folio *folio)
 	}
 }
 
+/*
+ * Copy from the page cache under rcu_read_lock(), without taking folio
+ * references.  A folio removed from the page cache is freed only after an
+ * RCU grace period (PG_rcu_free), so a page found in i_pages here holds
+ * the file's data until rcu_read_unlock(), whatever happens to the folio
+ * meanwhile: reclaim, truncation, migration or a split.  That is what the
+ * slow path's reference gives it, from the lookup to the end of the copy.
+ * The folios that are not marked do not get here: the file holds the
+ * reference to the inode that folio_mark_removed_from_cache() asks for,
+ * and hugetlbfs has its own read.
+ *
+ * Copy page by page, each page looked up in i_pages.  Without a reference
+ * a split can change the folio's size under us, so only the page at the
+ * index xas_load() returned the folio for is known to be part of it.
+ * The folio's flags are checked once per folio: prev is the folio of the
+ * previous page.
+ *
+ * Copy at most FOLIO_BATCH_SIZE pages under one rcu_read_lock().  Return
+ * true if that many were copied and the read is not done.  prev is not
+ * kept across batches: after rcu_read_unlock() another folio can be at
+ * the same address.
+ */
+static bool filemap_read_rcu_batch(struct kiocb *iocb, struct iov_iter *iter,
+		loff_t last_pos, size_t *copied)
+{
+	struct address_space *mapping = iocb->ki_filp->f_mapping;
+	struct inode *inode = mapping->host;
+	XA_STATE(xas, &mapping->i_pages, 0);
+	struct folio *prev = NULL;
+	bool more = false;
+	int nr;
+
+	/*
+	 * No flush_dcache_folio() here: it has not been checked for a folio
+	 * without a reference (arm's writes folio->flags).  The slow path
+	 * reads such mappings.
+	 */
+	if (ARCH_IMPLEMENTS_FLUSH_DCACHE_PAGE &&
+	    mapping_writably_mapped(mapping))
+		return false;
+
+	/* A user fault cannot sleep in the RCU read section: it ends the copy */
+	rcu_read_lock();
+	pagefault_disable();
+	for (nr = 0; iov_iter_count(iter); nr++) {
+		loff_t pos = iocb->ki_pos;
+		pgoff_t index = pos >> PAGE_SHIFT;
+		size_t offset = offset_in_page(pos);
+		struct folio *folio;
+		size_t bytes, n;
+		loff_t isize;
+
+		if (nr == FOLIO_BATCH_SIZE) {
+			more = true;
+			break;
+		}
+
+		xas_set(&xas, index);
+		folio = xas_load(&xas);
+		if (xas_retry(&xas, folio) || !folio || xa_is_value(folio))
+			break;
+
+		if (folio != prev) {
+			if (!folio_test_uptodate(folio) ||
+			    folio_test_readahead(folio) ||
+			    folio_test_dropbehind(folio))
+				break;
+			/*
+			 * folio_mark_accessed() needs a reference, so stop
+			 * unless it would do nothing.  The slow path does not
+			 * call it for the folio the previous read ended in.
+			 * The folio's size cannot be read here, so this folio
+			 * is known to be that one only if the previous read
+			 * ended in a page from folio->index to index.
+			 */
+			if (!folio_mark_accessed_noop(folio) &&
+			    (prev || last_pos <= 0 ||
+			     (last_pos - 1) >> PAGE_SHIFT < folio->index ||
+			     (last_pos - 1) >> PAGE_SHIFT > index))
+				break;
+			prev = folio;
+		}
+
+		/* i_size must be checked after we know the folio is uptodate */
+		isize = i_size_read(inode);
+		if (pos >= isize)
+			break;
+		bytes = min_t(loff_t, isize - pos,
+			      min_t(size_t, iov_iter_count(iter),
+				    PAGE_SIZE - offset));
+
+		/*
+		 * Not copy_page_to_iter_nofault(): it runs the hardened
+		 * usercopy check, which loads the page's compound head and
+		 * then that head's order, and a split can run in between.
+		 * page_copy_sane() does not read the order for a copy within
+		 * one page.
+		 */
+		n = copy_page_to_iter(folio_page(folio, index - folio->index),
+				      offset, bytes, iter);
+		*copied += n;
+		iocb->ki_pos += n;
+		if (n < bytes)
+			break;
+	}
+	pagefault_enable();
+	rcu_read_unlock();
+
+	return more;
+}
+
+/*
+ * Copy from the page cache without folio references, in batches of
+ * FOLIO_BATCH_SIZE pages.  Stop at a user fault, at EOF, at a folio that
+ * is missing or not uptodate, at one that needs readahead, dropbehind or
+ * folio_mark_accessed(), and at a fatal signal.  The slow path continues
+ * from there.
+ */
+static size_t filemap_read_rcu(struct kiocb *iocb, struct iov_iter *iter,
+		loff_t last_pos)
+{
+	size_t copied = 0;
+
+	while (filemap_read_rcu_batch(iocb, iter, last_pos, &copied)) {
+		if (fatal_signal_pending(current))
+			break;
+		cond_resched();
+		/* Like the slow path, don't mark the folio we stopped in */
+		last_pos = iocb->ki_pos;
+	}
+	return copied;
+}
+
 /**
  * filemap_read - Read data from the page cache.
  * @iocb: The iocb to read.
@@ -2805,6 +2938,7 @@ ssize_t filemap_read(struct kiocb *iocb, struct iov_iter *iter,
 	bool writably_mapped;
 	loff_t isize, end_offset;
 	loff_t last_pos = ra->prev_pos;
+	size_t fast_read;
 
 	if (unlikely(iocb->ki_pos < 0))
 		return -EINVAL;
@@ -2816,6 +2950,14 @@ ssize_t filemap_read(struct kiocb *iocb, struct iov_iter *iter,
 	iov_iter_truncate(iter, inode->i_sb->s_maxbytes - iocb->ki_pos);
 	folio_batch_init(&fbatch);
 
+	fast_read = filemap_read_rcu(iocb, iter, last_pos);
+	if (fast_read) {
+		already_read += fast_read;
+		last_pos = iocb->ki_pos;
+		if (!iov_iter_count(iter))
+			goto out;
+	}
+
 	do {
 		cond_resched();
 
@@ -2902,6 +3044,7 @@ put_folios:
 		folio_batch_init(&fbatch);
 	} while (iov_iter_count(iter) && iocb->ki_pos < isize && !error);
 
+out:
 	file_accessed(filp);
 	ra->prev_pos = last_pos;
 	return already_read ? already_read : error;
diff --git a/mm/folio.c b/mm/folio.c
index 50a6dbe55..9b0669dcf 100644
--- a/mm/folio.c
+++ b/mm/folio.c
@@ -456,6 +472,22 @@ void folio_mark_accessed(struct folio *folio)
 }
 EXPORT_SYMBOL(folio_mark_accessed);
 
+/*
+ * Whether folio_mark_accessed() would leave @folio unchanged.  Only reads
+ * the flags, so it can be called without a reference on @folio.
+ */
+bool folio_mark_accessed_noop(struct folio *folio)
+{
+	if (folio_test_dropbehind(folio))
+		return true;
+	if (lru_gen_enabled())
+		return lru_gen_refs_full(folio);
+
+	return folio_test_referenced(folio) &&
+	       (folio_test_unevictable(folio) || folio_test_active(folio)) &&
+	       !folio_test_idle(folio);
+}
+
 /**
  * folio_add_lru - Add a folio to an LRU list.
  * @folio: The folio to be added to the LRU.
diff --git a/mm/internal.h b/mm/internal.h
index e276dc4b9..e99e44827 100644
--- a/mm/internal.h
+++ b/mm/internal.h
@@ -64,6 +64,7 @@ void lru_add_drain_cpu(int cpu);
 void lru_add_drain_cpu_zone(struct zone *zone);
 void folio_deactivate(struct folio *folio);
 void folio_mark_lazyfree(struct folio *folio);
+bool folio_mark_accessed_noop(struct folio *folio);
 
 /* mm/vmscan.c */
 unsigned long zone_reclaimable_pages(struct zone *zone);

From 59b394dd1882e25acab7450864d84820811ac9ae Mon Sep 17 00:00:00 2001
From: Linus Torvalds <torvalds@linux-foundation.org>
Date: Thu, 8 Oct 2026 23:00:27 +0200
Subject: [PATCH 6/9] mm: count pages whose free waits for an RCU grace period

Three vm events in /proc/vmstat: pgfree_rcu counts pages whose free
__free_pages_prepare() deferred because PG_rcu_free was set,
pgfree_rcu_done counts pages rcu_free_pages() returned to the allocator
after the grace period, and pgfree_rcu_skip counts pages that
folio_mark_removed_from_cache() did not mark because the inode is being
evicted.  pgfree_rcu - pgfree_rcu_done is the number of pages waiting;
it is approximate, because the per-CPU event counters are not summed
atomically.

These are for observation.  The waiting pages are still not in
NR_FREE_PAGES, and kernel code cannot read vm events cheaply, so this is
not the counter that the allocator needs.

Assisted-by: LLM
Signed-off-by: Linus Torvalds <torvalds@linux-foundation.org>
---
