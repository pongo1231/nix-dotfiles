+	case AMDGPU_GEM_OP_SET_PRIORITY: {
+		if (!amdgpu_vm_is_bo_always_valid(&fpriv->vm, robj) ||
+		    args->value > U32_MAX) {
+			drm_exec_fini(&exec);
