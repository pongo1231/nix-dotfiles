index 30636b9d9673..1ee974cb6d37 100644
--- a/mm/memcontrol.c
+++ b/mm/memcontrol.c
@@ -4745,6 +4745,7 @@ static int memory_peak_show(struct seq_file *sf, void *v)
 {
 	struct mem_cgroup *memcg = mem_cgroup_from_css(seq_css(sf));
 
+	guard(spinlock)(&memcg->peaks_lock);
