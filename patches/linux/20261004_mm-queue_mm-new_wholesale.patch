-				    settings->read_ahead_kb);
-
-		if (ret) {
-			print_file_access_error(dev_queue_read_ahead_path, ret);
-			exit(EXIT_FAILURE);
-		}
-	}
-
-	for (i = 0; i < NR_ORDERS; i++) {
-		if (!((1 << i) & orders))
-			continue;
-		snprintf(path, PATH_MAX, "hugepages-%ukB/enabled",
-			(getpagesize() >> 10) << i);
