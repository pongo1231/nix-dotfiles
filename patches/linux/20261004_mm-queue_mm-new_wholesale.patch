index e1b49c3d72b8..e49bbf7c07e8 100644
--- a/mm/damon/core.c
+++ b/mm/damon/core.c
@@ -2926,10 +2926,7 @@ static unsigned long damon_feed_loop_next_input(unsigned long last_input,
