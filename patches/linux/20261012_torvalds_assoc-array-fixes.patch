From 743a116a19a1302933c730cad31ff45f271285f1 Mon Sep 17 00:00:00 2001
From: Linus Torvalds <torvalds@linux-foundation.org>
Date: Sun, 11 Oct 2026 09:03:09 -0700
Subject: [PATCH 1/3] assoc_array: correct the documentation of
 get_key_chunk()'s level argument

assoc_array.rst says the level passed to get_key_chunk() will be a
multiple of ASSOC_ARRAY_KEY_CHUNK_SIZE, and asks for the chunk starting
at that bit.  assoc_array_walk() after a shortcut, and both insertion
paths, pass the level of a node, which is any multiple of 4.  Each then
shifts the chunk it gets back right by level & ASSOC_ARRAY_KEY_CHUNK_MASK,
so what it wants is the chunk that contains that bit.

The keyring code copes, because keyring_get_key_chunk() divides the
level by ASSOC_ARRAY_KEY_CHUNK_SIZE before using it.  An implementation
written to the documentation does not: one that returns a one-word key
for level 0 and nothing for any other level files leaves under the
wrong slot the first time a node is split, and a later insertion hits
the BUG_ON() after found_slot_for_multiple_occupancy in
assoc_array_insert_into_terminal_node().

Say what the code expects.  get_object_key_chunk() is documented as
"the previous function", so this covers it too.

Assisted-by: LLM
Signed-off-by: Linus Torvalds <torvalds@linux-foundation.org>
---
 Documentation/core-api/assoc_array.rst | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/Documentation/core-api/assoc_array.rst b/Documentation/core-api/assoc_array.rst
index 19d89f92b..1a6b3edec 100644
--- a/Documentation/core-api/assoc_array.rst
+++ b/Documentation/core-api/assoc_array.rst
@@ -123,10 +123,12 @@ This points to a number of methods, all of which need to be provided:
 
     unsigned long (*get_key_chunk)(const void *index_key, int level);
 
-   This should return a chunk of caller-supplied index key starting at the
-   *bit* position given by the level argument.  The level argument will be a
-   multiple of ``ASSOC_ARRAY_KEY_CHUNK_SIZE`` and the function should return
-   ``ASSOC_ARRAY_KEY_CHUNK_SIZE bits``.  No error is possible.
+   This should return the ``ASSOC_ARRAY_KEY_CHUNK_SIZE`` bits of
+   caller-supplied index key that contain the *bit* position given by the
+   level argument, starting at level rounded down to a multiple of
+   ``ASSOC_ARRAY_KEY_CHUNK_SIZE``.  The level is often that of a node, which
+   is any multiple of 4, so the function has to do the rounding.  No error is
+   possible.
 
 
 2. Get a chunk of an object's index key::

From 7dbb216b20ebb9010acd89688a5235e679a3df38 Mon Sep 17 00:00:00 2001
From: Linus Torvalds <torvalds@linux-foundation.org>
Date: Sun, 11 Oct 2026 09:03:19 -0700
Subject: [PATCH 2/3] assoc_array: don't lose objects when a shortcut is split
 on a word boundary

When assoc_array_insert_mid_shortcut() splits a shortcut at level diff,
the new shortcut in front of the split, new_s0, gets the first
round_up(diff, ASSOC_ARRAY_KEY_CHUNK_SIZE) bits of the old shortcut's
index key, and the bits from diff onwards are then cleared from its
last word:

	blank = ULONG_MAX << (diff & ASSOC_ARRAY_KEY_CHUNK_MASK);
	new_s0->index_key[keylen - 1] &= ~blank;

When diff is a multiple of ASSOC_ARRAY_KEY_CHUNK_SIZE, the shift is 0,
blank is all ones, and the whole last word is cleared, although all of
it lies below diff.  A walk then compares the key it is looking for
against that zeroed word, takes the shortcut to point elsewhere, and
every object below it can no longer be found.

assoc_array_insert_into_terminal_node() trims a new shortcut's key the
same way, and only when the level is not a multiple of the chunk size.
Do the same here.

Found by a userspace build of the array with a test that inserts, in
order, string keys whose first word is their length and the rest their
bytes.  The 102nd key split a shortcut at bit 256, and 76 of the keys
already in the array could no longer be found; AddressSanitizer also
reported assoc_array_walk() reading a word past the end of a shortcut's
index key.  With this change the test passes, and AddressSanitizer and
UndefinedBehaviorSanitizer report nothing.

Fixes: 3cb989501c26 ("Add a generic associative array implementation.")
Assisted-by: LLM
Signed-off-by: Linus Torvalds <torvalds@linux-foundation.org>
---
 lib/assoc_array.c | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/lib/assoc_array.c b/lib/assoc_array.c
index b6c9723e1..20ef69e03 100644
--- a/lib/assoc_array.c
+++ b/lib/assoc_array.c
@@ -865,9 +865,11 @@ static bool assoc_array_insert_mid_shortcut(struct assoc_array_edit *edit,
 		memcpy(new_s0->index_key, shortcut->index_key,
 		       flex_array_size(new_s0, index_key, keylen));
 
-		blank = ULONG_MAX << (diff & ASSOC_ARRAY_KEY_CHUNK_MASK);
-		pr_devel("blank off [%zu] %d: %lx\n", keylen - 1, diff, blank);
-		new_s0->index_key[keylen - 1] &= ~blank;
+		if (diff & ASSOC_ARRAY_KEY_CHUNK_MASK) {
+			blank = ULONG_MAX << (diff & ASSOC_ARRAY_KEY_CHUNK_MASK);
+			pr_devel("blank off [%zu] %d: %lx\n", keylen - 1, diff, blank);
+			new_s0->index_key[keylen - 1] &= ~blank;
+		}
 	} else {
 		pr_devel("no pre-shortcut\n");
 		edit->set[0].to = assoc_array_node_to_ptr(new_n0);

From 99b732910039cff618549b07bbff11f15810670a Mon Sep 17 00:00:00 2001
From: Linus Torvalds <torvalds@linux-foundation.org>
Date: Sun, 11 Oct 2026 09:56:16 -0700
Subject: [PATCH 3/3] assoc_array: don't lose objects when a root shortcut is
 split at level 4

assoc_array_insert_mid_shortcut() takes level, the level of the node
holding the shortcut as assoc_array_walk() reports it, and adds
ASSOC_ARRAY_LEVEL_STEP to get the level of a node in that shortcut's
place.  If the new key first differs from the shortcut no further in
than that, no shortcut is made in front of the split, and new_n0 takes
the old shortcut's place directly.

A shortcut at the root is held by no node.  assoc_array_walk() reports
level 0 for it, and whatever takes its place is the root, which is read
at level 0.  So when the new key first differs from a root shortcut in
bits 4-7, diff is 4, no shortcut is made in front, and new_n0, whose
slots are indexed by bits 4-7, becomes the root and is indexed by bits
0-3.  Objects already in the array can no longer be found, and the new
one lands in a slot its key does not select.

Eighteen keys are enough: seventeen that agree on bits 0-7 make the root
a shortcut, and one that agrees with them on bits 0-3 only splits it.
Three of the eighteen objects can then not be found, and inserting one
of those keys again adds a second object instead of replacing it.

Only add the step for a shortcut that hangs from a node.  A root
shortcut split at level 4 then gets a shortcut in front of the split
that ends at level 4, as assoc_array_insert_into_terminal_node() already
makes when the leaves of a full root node first differ there.

Found by a userspace test that builds a shortcut ending at every level
and splits it at every level inside it, from the root and from a node:
every split of a root shortcut at level 4 failed, and nothing else did.

Fixes: 3cb989501c26 ("Add a generic associative array implementation.")
Assisted-by: LLM
Signed-off-by: Linus Torvalds <torvalds@linux-foundation.org>
---
 lib/assoc_array.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/lib/assoc_array.c b/lib/assoc_array.c
index 20ef69e03..5611da338 100644
--- a/lib/assoc_array.c
+++ b/lib/assoc_array.c
@@ -843,7 +843,8 @@ static bool assoc_array_insert_mid_shortcut(struct assoc_array_edit *edit,
 	 * zero length - otherwise we just connect the new node directly to the
 	 * parent.
 	 */
-	level += ASSOC_ARRAY_LEVEL_STEP;
+	if (shortcut->back_pointer)
+		level += ASSOC_ARRAY_LEVEL_STEP;
 	if (diff > level) {
 		pr_devel("pre-shortcut %d...%d\n", level, diff);
 		keylen = round_up(diff, ASSOC_ARRAY_KEY_CHUNK_SIZE);

assoc-array-fixes (torvalds tag, 15 commits) -- header for the assoc patch file(s)
This text heads the assoc-array-fixes material in either layout: one file carrying all 15
sections, or the existing 3-section 20261012_torvalds_assoc-array-fixes.patch plus
restore.patch, which carries the tag's sections 4-15 (the 12 commits the 3-section file
leaves out) and must be applied after it, in the order below.

Source: https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git
        tag assoc-array-fixes = annotated tag d09c91d022a36e6a471db39577f6da81c705e56b,
        tagged object 99136562aa5b8599e1e565d8dace29554c84c969, tag date 2026-10-11
        12:54:56 -0700, tag message "Clean up assoc_array library".
Base:   Merge tag riscv-for-linus-7.3-rc7 (b2d929a1c2a8). The tag's oldest commit,
        743a116a19a1, has b2d929a1c2a8 as its parent (verified from the object graph).

The tag is 15 commits, all touching lib/assoc_array.c except the first (which touches
only Documentation/core-api/assoc_array.rst) and 65a9b4df5a2c (which also changes
include/linux/assoc_array_priv.h).  Tag order (git rev-list b2d929a1c2a8..99136562aa5b,
15 commits -- note 722c861ed568 is #11 in the chain, not the tip; 99136562aa5b is the tip):

  #  commit        kind      subject
  1  743a116a19a1  DOC       correct the documentation of get_key_chunk()'s level argument
  2  7dbb216b20eb  BUG-FIX   don't lose objects when a shortcut is split on a word boundary
  3  99b732910039  BUG-FIX   don't lose objects when a root shortcut is split at level 4
  4  d8854b39950a  REFACTOR  move in-place insertion into a function of its own
  5  ff9b071c0e49  REFACTOR  fill the segment cache in one place
  6  9f4da2809e54  REFACTOR  move node splitting into a function of its own
  7  cfc1c672c567  REFACTOR  move shortcut creation into a function of its own
  8  2e5d46264617  REFACTOR  choose between splitting a node and a shortcut without gotos
  9  65a9b4df5a2c  BUG-FIX   don't chain a new shortcut onto an existing one
 10  345c38d6caa9  BUG-FIX   keep gc's cleanup out of the live tree on allocation failure
 11  722c861ed568  REFACTOR  move gc's folding into a function of its own
 12  0bb1b14e5c6c  REFACTOR  replace the labels in gc's tree walk with a loop
 13  970ec6804344  REFACTOR  move deletion's collapse into a function of its own
 14  f4ae215f0a93  REFACTOR  find and collapse in deletion without gotos
 15  99136562aa5b  REFACTOR  use assoc_array_parent_link() when splitting a shortcut

CORRECTION to the previous header of this patch file ("the remaining 12 commits of the
tag are a goto-removal refactor of the deletion collapse ... and is cosmetic"): that is
false in two ways.

1. Nature. The omitted 12 are NOT one cosmetic refactor. Two of them are behavioural bug
   fixes whose code is absent from a tree that carries only commits 1-3:
     - 65a9b4df5a2c ("don't chain a new shortcut onto an existing one", Fixes: 3cb989501c26,
       Reported-by: Nils Ollrogge): assoc_array_insert_shortcut() installs a new shortcut
       where a node sat even when that node is itself the target of a shortcut, chaining
       shortcut -> shortcut; assoc_array_walk() then indexes the second one as a node
       (BUG_ON(!assoc_array_ptr_is_node(cursor))) and assoc_array_apply_edit() hits
       BUG_ON(!assoc_array_ptr_is_node(ptr)) while propagating nr_leaves_on_branch. It
       needs a second excised_meta[] entry (priv.h excised_meta[1] -> [2]) to retire the
       replaced shortcut.
     - 345c38d6caa9 ("keep gc's cleanup out of the live tree on allocation failure",
       Fixes: 3cb989501c26): assoc_array_gc() copies the shortcut before the node it leads
       to and links the copy (whose next_node still points into the old tree) into the new
       tree first, so if the node allocation fails, assoc_array_destroy_subtree() on the
       new tree walks into the live tree and the BUG_ON()s fire.
   The other ten are moves: per commit, the statements added are the statements removed
   (the only differences are comments, declarations, pr_devel strings, braces, and the
   label/goto or BUG() -> BUG_ON() rewrites), and the predicates they compute are the
   same -- e.g. 2e5d46264617's assoc_array_all_one_segment() folds the old two tests
   (old leaves in one slot, new key's segment equal to theirs) into one loop over
   segment_cache[1..ASSOC_ARRAY_FAN_OUT], and 99136562aa5b's assoc_array_parent_link()
   call with shortcut->back_pointer/parent_slot is the case analysis it replaces.
   Classifying all 12 as "cosmetic" understates the drop by two kernel-crashing fixes.

2. Order. 722c861ed568 ("move gc's folding into a function of its own") is not the last
   commit of the tag: it is #11, between 345c38d6caa9 and 0bb1b14e5c6c. Sections must be
   applied in the order above, which is the order they appear in this file.

Retargeting (sections 13 and 14 of the tag; they are sections 10 and 11 of restore.patch):
  Sections 13 (970ec6804344) and 14 (f4ae215f0a93) move and then rewrite exactly the code
  region that the mm-new queue's own assoc change 61192bf3db8a ("assoc_array: discard
  shortcut when collapsing a leaf-only node", in 20261009_mm-queue_mm-new_wholesale.patch,
  commit 427/728) modifies inside assoc_array_delete() -- the collapse that drops a
  redundant shortcut above a leaf-only node. Their upstream hunks do not match the stack's
  code there, and their hunks that DO match (the added function body) carry upstream's
  pre-61192bf text, so applying them verbatim would silently revert 61192bf3db8a rather
  than fail. The two sections in this file are therefore retargeted: the moved/rewritten
  function carries the bypass (new_n0->back_pointer/parent_slot taken from the shortcut,
  edit->excised_subtree = the shortcut) and the parent link and BUG_ON use new_n0's
  (bypassed) back pointer, which is what assoc_array_parent_link() dereferences. Everything
  else in those two commits is upstream's text unchanged. The mm-new queue's fix does not
  make any of the 12 commits redundant, and vice versa: 61192bf3db8a fixes the deletion
  side (a leaf-only node left under a redundant shortcut), 65a9b4df5a2c fixes the insertion
  side (a full node below a shortcut replaced by a new shortcut), and they touch disjoint
  code.
From d8854b39950a0407cb3923c6a3653aeb91bbd3bc Mon Sep 17 00:00:00 2001
From: Linus Torvalds <torvalds@linux-foundation.org>
Date: Sun, 11 Oct 2026 10:25:12 -0700
Subject: [PATCH] assoc_array: move in-place insertion into a function of its
 own

assoc_array_insert_into_terminal_node() is over 300 lines and does four
jobs, joined by gotos: putting the new leaf in place of a matching one
or in a free slot, working out the segment of each leaf, splitting the
node, and replacing the node with a shortcut.  The last two share the
function's tail, which installs the replacement where the node was.

Move the jobs into functions of their own, one per commit, starting with
the two cases that need no new node: assoc_array_insert_in_node().

No functional change.

Assisted-by: LLM
Signed-off-by: Linus Torvalds <torvalds@linux-foundation.org>
---
 lib/assoc_array.c | 68 ++++++++++++++++++++++++++++++-----------------
 1 file changed, 43 insertions(+), 25 deletions(-)

diff --git a/lib/assoc_array.c b/lib/assoc_array.c
index 5611da338e1c..11b92b6bb8e1 100644
--- a/lib/assoc_array.c
+++ b/lib/assoc_array.c
@@ -470,33 +470,17 @@ static bool assoc_array_insert_in_empty_tree(struct assoc_array_edit *edit)
 }
 
 /*
- * Handle insertion into a terminal node.
+ * Insert into a terminal node without changing its shape, if that can be
+ * done: in place of a leaf with the same index key, or in a free slot.
  */
-static bool assoc_array_insert_into_terminal_node(struct assoc_array_edit *edit,
-						  const struct assoc_array_ops *ops,
-						  const void *index_key,
-						  struct assoc_array_walk_result *result)
+static bool assoc_array_insert_in_node(struct assoc_array_edit *edit,
+				       const struct assoc_array_ops *ops,
+				       const void *index_key,
+				       struct assoc_array_node *node)
 {
-	struct assoc_array_shortcut *shortcut, *new_s0;
-	struct assoc_array_node *node, *new_n0, *new_n1, *side;
 	struct assoc_array_ptr *ptr;
-	unsigned long dissimilarity, base_seg, blank;
-	size_t keylen;
-	bool have_meta;
-	int level, diff;
-	int slot, next_slot, free_slot, i, j;
-
-	node	= result->terminal_node.node;
-	level	= result->terminal_node.level;
-	edit->segment_cache[ASSOC_ARRAY_FAN_OUT] = result->terminal_node.slot;
-
-	pr_devel("-->%s()\n", __func__);
+	int free_slot, i;
 
-	/* We arrived at a node which doesn't have an onward node or shortcut
-	 * pointer that we have to follow.  This means that (a) the leaf we
-	 * want must go here (either by insertion or replacement) or (b) we
-	 * need to split this node and insert in one of the fragments.
-	 */
 	free_slot = -1;
 
 	/* Firstly, we have to check the leaves in this node to see if there's
@@ -514,7 +498,6 @@ static bool assoc_array_insert_into_terminal_node(struct assoc_array_edit *edit,
 			pr_devel("replace in slot %d\n", i);
 			edit->leaf_p = &node->slots[i];
 			edit->dead_leaf = node->slots[i];
-			pr_devel("<--%s() = ok [replace]\n", __func__);
 			return true;
 		}
 	}
@@ -526,7 +509,42 @@ static bool assoc_array_insert_into_terminal_node(struct assoc_array_edit *edit,
 		pr_devel("insert in free slot %d\n", free_slot);
 		edit->leaf_p = &node->slots[free_slot];
 		edit->adjust_count_on = node;
-		pr_devel("<--%s() = ok [insert]\n", __func__);
+		return true;
+	}
+
+	return false;
+}
+
+/*
+ * Handle insertion into a terminal node.
+ */
+static bool assoc_array_insert_into_terminal_node(struct assoc_array_edit *edit,
+						  const struct assoc_array_ops *ops,
+						  const void *index_key,
+						  struct assoc_array_walk_result *result)
+{
+	struct assoc_array_shortcut *shortcut, *new_s0;
+	struct assoc_array_node *node, *new_n0, *new_n1, *side;
+	struct assoc_array_ptr *ptr;
+	unsigned long dissimilarity, base_seg, blank;
+	size_t keylen;
+	bool have_meta;
+	int level, diff;
+	int slot, next_slot, free_slot, i, j;
+
+	node	= result->terminal_node.node;
+	level	= result->terminal_node.level;
+	edit->segment_cache[ASSOC_ARRAY_FAN_OUT] = result->terminal_node.slot;
+
+	pr_devel("-->%s()\n", __func__);
+
+	/* We arrived at a node which doesn't have an onward node or shortcut
+	 * pointer that we have to follow.  This means that (a) the leaf we
+	 * want must go here (either by insertion or replacement) or (b) we
+	 * need to split this node and insert in one of the fragments.
+	 */
+	if (assoc_array_insert_in_node(edit, ops, index_key, node)) {
+		pr_devel("<--%s() = ok [in node]\n", __func__);
 		return true;
 	}
 
From ff9b071c0e49c14be3089a6d9ef0d3b16e9e59ae Mon Sep 17 00:00:00 2001
From: Linus Torvalds <torvalds@linux-foundation.org>
Date: Sun, 11 Oct 2026 10:25:12 -0700
Subject: [PATCH] assoc_array: fill the segment cache in one place

The loop that records the segment of each leaf in a full node is written
out twice in assoc_array_insert_into_terminal_node(): for the node at
its own level, and again at the far end of a shortcut that replaces it.
Make it assoc_array_segment_leaves().

The second copy did not look for metadata pointers, because that path is
only taken for a node holding nothing but leaves, so the function finds
none there.  The new key's segment is still set by each caller, from the
walk the first time and from the key the second.

No functional change.

Assisted-by: LLM
Signed-off-by: Linus Torvalds <torvalds@linux-foundation.org>
---
 lib/assoc_array.c | 56 +++++++++++++++++++++++++++++------------------
 1 file changed, 35 insertions(+), 21 deletions(-)

diff --git a/lib/assoc_array.c b/lib/assoc_array.c
index 11b92b6bb8e1..0518a7a2df90 100644
--- a/lib/assoc_array.c
+++ b/lib/assoc_array.c
@@ -515,6 +515,38 @@ static bool assoc_array_insert_in_node(struct assoc_array_edit *edit,
 	return false;
 }
 
+/*
+ * Fill in the edit script's segment cache for a full node: the segment at
+ * this level of each leaf's index key, or 0xff for a metadata pointer.
+ * The new key's segment, in the last entry, is left to the caller.  Returns
+ * true if there are any metadata pointers.
+ */
+static bool assoc_array_segment_leaves(struct assoc_array_edit *edit,
+				       const struct assoc_array_ops *ops,
+				       const struct assoc_array_node *node,
+				       int level)
+{
+	struct assoc_array_ptr *ptr;
+	unsigned long base_seg;
+	bool have_meta;
+	int i;
+
+	have_meta = false;
+	for (i = 0; i < ASSOC_ARRAY_FAN_OUT; i++) {
+		ptr = node->slots[i];
+		if (assoc_array_ptr_is_meta(ptr)) {
+			edit->segment_cache[i] = 0xff;
+			have_meta = true;
+			continue;
+		}
+		base_seg = ops->get_object_key_chunk(
+			assoc_array_ptr_to_leaf(ptr), level);
+		base_seg >>= level & ASSOC_ARRAY_KEY_CHUNK_MASK;
+		edit->segment_cache[i] = base_seg & ASSOC_ARRAY_FAN_MASK;
+	}
+	return have_meta;
+}
+
 /*
  * Handle insertion into a terminal node.
  */
@@ -534,7 +566,6 @@ static bool assoc_array_insert_into_terminal_node(struct assoc_array_edit *edit,
 
 	node	= result->terminal_node.node;
 	level	= result->terminal_node.level;
-	edit->segment_cache[ASSOC_ARRAY_FAN_OUT] = result->terminal_node.slot;
 
