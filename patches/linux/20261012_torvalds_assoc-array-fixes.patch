From f4ae215f0a9319207984a9a1ab6c5eb9f56cec0c Mon Sep 17 00:00:00 2001
From: Linus Torvalds <torvalds@linux-foundation.org>
Date: Sun, 11 Oct 2026 11:44:59 -0700
Subject: [PATCH] assoc_array: find and collapse in deletion without gotos

Finding the leaf to delete is a switch whose one useful case falls
through into the cases that give up, and is left by a goto to
found_leaf.  Make it an if, and a loop that stops at the leaf.

The climb to the highest node the collapse can merge into is two
labels, collapse_up and do_collapse.  Make it a for loop that stops at
the root or at a node with too many leaves.  The new node's place is
found with assoc_array_parent_link(), keeping the check against a leaf
as a back pointer as a BUG_ON(), and the cleanup after a failed
allocation moves to the one place that needs it.

There is no recursion, and assoc_array_delete()'s stack frame is 160
bytes against 176 before, on an x86-64 defconfig.

No functional change.

Assisted-by: LLM
Signed-off-by: Linus Torvalds <torvalds@linux-foundation.org>
---
 lib/assoc_array.c | 67 +++++++++++++++++++----------------------------
 1 file changed, 27 insertions(+), 40 deletions(-)

diff --git a/lib/assoc_array.c b/lib/assoc_array.c
index c4cb1c6..126cd96 100644
--- a/lib/assoc_array.c
+++ b/lib/assoc_array.c
@@ -1165,27 +1165,20 @@ static bool assoc_array_delete_collapse(struct assoc_array_edit *edit,
 	/* Look further up the tree to see if we can collapse this node
 	 * into a more proximal node too.
 	 */
-	parent = node;
-collapse_up:
-	pr_devel("collapse subtree: %ld\n", parent->nr_leaves_on_branch);
+	for (parent = node;; parent = grandparent) {
+		pr_devel("collapse subtree: %ld\n", parent->nr_leaves_on_branch);
 
-	ptr = parent->back_pointer;
-	if (!ptr)
-		goto do_collapse;
-	if (assoc_array_ptr_is_shortcut(ptr)) {
-		struct assoc_array_shortcut *s = assoc_array_ptr_to_shortcut(ptr);
-		ptr = s->back_pointer;
+		ptr = parent->back_pointer;
+		if (ptr && assoc_array_ptr_is_shortcut(ptr))
+			ptr = assoc_array_ptr_to_shortcut(ptr)->back_pointer;
 		if (!ptr)
-			goto do_collapse;
-	}
+			break;
 
-	grandparent = assoc_array_ptr_to_node(ptr);
-	if (grandparent->nr_leaves_on_branch <= ASSOC_ARRAY_FAN_OUT + 1) {
-		parent = grandparent;
-		goto collapse_up;
+		grandparent = assoc_array_ptr_to_node(ptr);
+		if (grandparent->nr_leaves_on_branch > ASSOC_ARRAY_FAN_OUT + 1)
+			break;
 	}
 
-do_collapse:
 	/* There's no point collapsing if the original node has no meta
 	 * pointers to discard and if we didn't merge into one of that
 	 * node's ancestry.
@@ -1228,14 +1221,11 @@ do_collapse:
 		pr_devel("collapsed %d,%lu\n", collapse.slot, new_n0->nr_leaves_on_branch);
 		BUG_ON(collapse.slot != new_n0->nr_leaves_on_branch - 1);
 
-		if (!new_n0->back_pointer) {
-			edit->set[1].ptr = &edit->array->root;
-		} else {
-			struct assoc_array_node *p;
-
-			p = assoc_array_ptr_to_node(new_n0->back_pointer);
-			edit->set[1].ptr = &p->slots[new_n0->parent_slot];
-		}
+		BUG_ON(new_n0->back_pointer &&
+		       assoc_array_ptr_is_leaf(new_n0->back_pointer));
+		edit->set[1].ptr = assoc_array_parent_link(edit->array,
+							   new_n0->back_pointer,
+							   new_n0->parent_slot);
 		edit->set[1].to = assoc_array_node_to_ptr(new_n0);
 	}
 	return true;
@@ -1279,8 +1269,10 @@ struct assoc_array_edit *assoc_array_delete(struct assoc_array *array,
 	edit->ops = ops;
 	edit->adjust_count_by = -1;
 
-	switch (assoc_array_walk(array, ops, index_key, &result)) {
-	case assoc_array_walk_found_terminal_node:
+	node = NULL;
+	slot = ASSOC_ARRAY_FAN_OUT;
+	if (assoc_array_walk(array, ops, index_key, &result) ==
+	    assoc_array_walk_found_terminal_node) {
 		/* We found a node that should contain the leaf we've been
 		 * asked to remove - *if* it's in the tree.
 		 */
@@ -1293,18 +1285,15 @@ struct assoc_array_edit *assoc_array_delete(struct assoc_array *array,
 			    assoc_array_ptr_is_leaf(ptr) &&
 			    ops->compare_object(assoc_array_ptr_to_leaf(ptr),
 						index_key))
-				goto found_leaf;
+				break;
 		}
-		fallthrough;
-	case assoc_array_walk_tree_empty:
-	case assoc_array_walk_found_wrong_shortcut:
-	default:
+	}
+	if (slot == ASSOC_ARRAY_FAN_OUT) {
 		assoc_array_cancel_edit(edit);
 		pr_devel("not found\n");
 		return NULL;
 	}
 
-found_leaf:
 	BUG_ON(array->nr_leaves_on_tree <= 0);
 
 	/* In the simplest form of deletion we just clear the slot and release
@@ -1338,16 +1327,14 @@ found_leaf:
 	 * up space in this node.
 	 */
 	if (node->nr_leaves_on_branch <= ASSOC_ARRAY_FAN_OUT + 1 &&
-	    !assoc_array_delete_collapse(edit, node))
-		goto enomem;
+	    !assoc_array_delete_collapse(edit, node)) {
+		/* Clean up after an out of memory error */
+		pr_devel("enomem\n");
+		assoc_array_cancel_edit(edit);
+		return ERR_PTR(-ENOMEM);
+	}
 
 	return edit;
-
-enomem:
-	/* Clean up after an out of memory error */
-	pr_devel("enomem\n");
-	assoc_array_cancel_edit(edit);
-	return ERR_PTR(-ENOMEM);
 }
 
 /**
From 99136562aa5b8599e1e565d8dace29554c84c969 Mon Sep 17 00:00:00 2001
From: Linus Torvalds <torvalds@linux-foundation.org>
Date: Sun, 11 Oct 2026 11:44:59 -0700
Subject: [PATCH] assoc_array: use assoc_array_parent_link() when splitting a
 shortcut

assoc_array_insert_mid_shortcut() works out by hand which pointer leads
to the shortcut it splits: the same cases as assoc_array_parent_link(),
with a BUG() for a shortcut behind anything but a node.  Use the
function, and keep the check as a BUG_ON().

No functional change.

Assisted-by: LLM
Signed-off-by: Linus Torvalds <torvalds@linux-foundation.org>
---
 lib/assoc_array.c | 15 ++++++---------
 1 file changed, 6 insertions(+), 9 deletions(-)

diff --git a/lib/assoc_array.c b/lib/assoc_array.c
index 7a63298a7885..729efdf83acd 100644
--- a/lib/assoc_array.c
+++ b/lib/assoc_array.c
@@ -869,7 +869,7 @@ static bool assoc_array_insert_mid_shortcut(struct assoc_array_edit *edit,
 					    struct assoc_array_walk_result *result)
 {
 	struct assoc_array_shortcut *shortcut, *new_s0, *new_s1;
-	struct assoc_array_node *node, *new_n0, *side;
+	struct assoc_array_node *new_n0, *side;
 	unsigned long sc_segments, dissimilarity, blank;
 	size_t keylen;
 	int level, sc_level, diff;
@@ -895,14 +895,11 @@ static bool assoc_array_insert_mid_shortcut(struct assoc_array_edit *edit,
 	diff += sc_level & ~ASSOC_ARRAY_KEY_CHUNK_MASK;
 	pr_devel("diff=%d\n", diff);
 
-	if (!shortcut->back_pointer) {
-		edit->set[0].ptr = &edit->array->root;
-	} else if (assoc_array_ptr_is_node(shortcut->back_pointer)) {
-		node = assoc_array_ptr_to_node(shortcut->back_pointer);
-		edit->set[0].ptr = &node->slots[shortcut->parent_slot];
-	} else {
-		BUG();
-	}
+	BUG_ON(shortcut->back_pointer &&
+	       !assoc_array_ptr_is_node(shortcut->back_pointer));
+	edit->set[0].ptr = assoc_array_parent_link(edit->array,
+						   shortcut->back_pointer,
+						   shortcut->parent_slot);
 
 	edit->excised_meta[0] = assoc_array_shortcut_to_ptr(shortcut);
 
