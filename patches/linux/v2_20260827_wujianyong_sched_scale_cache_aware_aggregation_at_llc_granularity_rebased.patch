+		/* Don't migrate if this is a good place to live. */
+		for_each_llc_node_span_from(node, llc_id(target_cpu), span) {
+			get_span_stats(span, &u, &c);
+			if (cpumask_test_cpu(src_cpu, span)) {
+				if (fits_llc_capacity(u, c))
+					return mig_forbid;
+			} else {
