 import * as Taskbar from './taskbar.js'
 import * as Utils from './utils.js'
 import { SETTINGS, DESKTOPSETTINGS } from './extension.js'
@@ -57,6 +62,322 @@ let scaleFactor = 1
 let animationTime = 0
 let aspectRatio = {}
 
+// --- Audio controls ---------------------------------------------------------
+// Playback streams are identified from `pw-dump` and controlled through Gvc
+// (volume, mute) plus MPRIS (transport). audioMatch.js resolves which app owns
+// a stream; this half joins the two stream representations and renders a
+// KDE-style volume slider in the preview.
+const AUDIO_ICON_SIZE = 16
+const AUDIO_CONTROL_ICON_SIZE = 16
+const AUDIO_DUMP_MIN_MS = 400
+// A running stream drops back to idle between one-shot sounds in games, and
+// pw-dump is only polled, so hold the row up for a moment after it stops.
+const AUDIO_HOLD_MS = 2500
+const AUDIO_POLL_MS = 1000
+
+let audioControl = null
+// pulse stream index -> Gvc.MixerStream (volume/mute handles)
+let audioStreamsByIndex = new Map()
+// pulse stream index -> stream identity from pw-dump
+let audioNodes = new Map()
+let audioDumpPending = false
+let audioDumpLast = 0
+let audioPollId = 0
+const audioRowUpdaters = new Set()
+// App identities that have been attributed a stream by pid; shared by every
+// caller of audioMatch.findNodesForApp().
+const audioPidMatchedNames = new Set()
+// pid -> {ancestors, time}, see _ancestorsOf()
+const audioAncestors = new Map()
+const AUDIO_ANCESTORS_TTL_MS = 5000
+const audioDecoder = new TextDecoder()
+
+function _ppid(pid) {
+  let contents
+
+  try {
+    ;[, contents] = Gio.File.new_for_path(`/proc/${pid}/stat`).load_contents(null)
+  } catch (e) {
+    return 0
+  }
+
+  // field 2 (comm) is parenthesised and may contain spaces and parentheses
+  let stat = audioDecoder.decode(contents)
+
+  return Number(stat.slice(stat.lastIndexOf(')') + 2).split(' ')[1]) || 0
+}
+
+// A stream rarely comes from the process that owns the window: Wine's audio
+// runs inside a Wine helper, Java games play from a JVM a launcher forked,
+// browsers from a content process. Walking /proc finds the task either way.
+function _ancestorsOf(pid) {
+  let now = Date.now()
+  let cached = audioAncestors.get(pid)
+
+  if (cached && now - cached.time < AUDIO_ANCESTORS_TTL_MS) return cached.pids
+
+  let pids = new Set()
+  let current = pid
+
+  for (let depth = 0; depth < 16 && current > 1 && !pids.has(current); depth++) {
+    pids.add(current)
+    current = _ppid(current)
+  }
+
+  if (current > 1) pids.add(current)
+
+  if (audioAncestors.size > 256) audioAncestors.clear()
+  audioAncestors.set(pid, { pids, time: now })
+
+  return pids
+}
+
+function _holdAudioVisibility(nodes) {
+  let now = Date.now()
+
+  for (let node of nodes.values()) {
+    let previous = audioNodes.get(node.index)
+    let lastPlaying = node.playing ? now : (previous && previous.lastPlaying) || 0
+
+    node.lastPlaying = lastPlaying
+    node.playing = node.playing || now - lastPlaying < AUDIO_HOLD_MS
+  }
+
+  return nodes
+}
+
+function _refreshAudioNodes() {
+  let now = Date.now()
+
+  if (audioDumpPending || now - audioDumpLast < AUDIO_DUMP_MIN_MS) return
+
+  audioDumpPending = true
+  audioDumpLast = now
+
+  let proc
+  try {
+    proc = Gio.Subprocess.new(
+      ['pw-dump'],
+      Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE,
+    )
+  } catch (e) {
+    audioDumpPending = false
+    return
+  }
+
+  proc.communicate_utf8_async(null, null, (p, res) => {
+    audioDumpPending = false
+
+    let stdout
+    try {
+      ;[, stdout] = p.communicate_utf8_finish(res)
+    } catch (e) {
+      return
+    }
+
+    let nodes = AudioMatch.parsePipewireDump(stdout)
+    if (!nodes) return
+
+    audioNodes = _holdAudioVisibility(nodes)
+    refreshAudioStreams()
+  })
+}
+
+// Gvc only reports stream-added/stream-removed; a stream that starts or stops
+// playing keeps its index, so the preview would stay stale between events.
+function _startAudioPoll() {
+  if (audioPollId) return
+
+  audioPollId = GLib.timeout_add(GLib.PRIORITY_DEFAULT, AUDIO_POLL_MS, () => {
+    _refreshAudioNodes()
+    return GLib.SOURCE_CONTINUE
+  })
+}
+
+function _stopAudioPoll() {
+  if (!audioPollId) return
+
+  GLib.source_remove(audioPollId)
+  audioPollId = 0
+}
+
+function _collectAudioStreams() {
+  audioStreamsByIndex = new Map()
+
+  if (!audioControl) return
+
+  // Gvc numbers sink inputs by their pulse index, which pipewire-pulse derives
+  // from the PipeWire object serial -- the number pw-dump reports as
+  // `object.serial`, so both listings join on it exactly.
+  for (let stream of audioControl.get_sink_inputs())
+    audioStreamsByIndex.set(stream.get_index(), stream)
+}
+
+function _appAudioIdentity(app) {
+  let pids = []
+  let identities = new Set()
+
+  let appId = String(app.get_id() || '')
+    .toLowerCase()
+    .replace(/\.desktop$/, '')
+  let name = String(app.get_name() || '').toLowerCase()
+
+  if (name) identities.add(name)
+  if (appId) identities.add(appId)
+
+  try {
+    for (let window of app.get_windows()) {
+      let pid = window.get_pid()
+      if (pid > 0) pids.push(pid)
+
+      let wmClass = String(window.get_wm_class() || '').toLowerCase()
+      if (wmClass) {
+        identities.add(wmClass)
+        if (wmClass.endsWith('.exe')) identities.add(wmClass.slice(0, -4))
+      }
+    }
+  } catch (e) {}
+
+  return { appId, pids, identities }
+}
+
+function getAudioControl() {
+  if (!audioControl) {
+    audioControl = Volume.getMixerControl()
+    audioControl.connect('stream-added', () => refreshAudioStreams())
+    audioControl.connect('stream-removed', () => refreshAudioStreams())
+    _collectAudioStreams()
+  }
+
+  return audioControl
+}
+
+function refreshAudioStreams() {
+  _collectAudioStreams()
+
+  for (let updater of [...audioRowUpdaters]) updater()
+}
+
+function getStreamsForApp(app) {
+  getAudioControl()
+
+  if (!app || !audioNodes.size) return []
+
+  let nodes = AudioMatch.findNodesForApp(audioNodes, _appAudioIdentity(app), {
+    ancestorsOf: _ancestorsOf,
+    pidMatchedNames: audioPidMatchedNames,
+  })
+
+  return nodes
+    .filter((node) => node.playing)
+    .map((node) => audioStreamsByIndex.get(node.index))
+    .filter((stream) => !!stream)
+}
+
+// --- MPRIS: playback controls for the app's active media player -------------
+const mprisPlayers = new Map()
+let mprisRequestPending = false
+let mprisLastRequest = 0
+const MPRIS_MIN_MS = 500
+
+function _mprisKey(busName) {
+  return busName
+    .replace(/^org\.mpris\.MediaPlayer2\./, '')
+    .replace(/\.instance.*$/, '')
+    .toLowerCase()
+}
+
+function _refreshMpris() {
+  let now = Date.now()
+
+  if (mprisRequestPending || now - mprisLastRequest < MPRIS_MIN_MS) return
+
+  mprisRequestPending = true
+  mprisLastRequest = now
+
+  Gio.DBus.session.call(
+    'org.freedesktop.DBus',
+    '/org/freedesktop/DBus',
+    'org.freedesktop.DBus',
+    'ListNames',
+    null,
+    null,
+    Gio.DBusCallFlags.NONE,
+    -1,
+    null,
+    (connection, res) => {
+      mprisRequestPending = false
+
+      let names
+      try {
+        names = connection.call_finish(res).deep_unpack()[0]
+      } catch (e) {
+        return
+      }
+
+      for (let name of names) {
+        if (!name.startsWith('org.mpris.MediaPlayer2.') || mprisPlayers.has(name))
+          continue
+
+        mprisPlayers.set(name, null)
+
+        Gio.DBusProxy.new(
+          Gio.DBus.session,
+          Gio.DBusProxyFlags.NONE,
+          null,
+          name,
+          '/org/mpris/MediaPlayer2',
+          'org.mpris.MediaPlayer2.Player',
+          null,
+          (source, result) => {
+            try {
+              let proxy = Gio.DBusProxy.new_finish(result)
+              mprisPlayers.set(name, proxy)
+              proxy.connect('g-properties-changed', () => refreshAudioStreams())
+            } catch (e) {
+              mprisPlayers.delete(name)
+            }
+
+            refreshAudioStreams()
+          },
+        )
+      }
+
+      for (let name of [...mprisPlayers.keys()])
+        if (!names.includes(name)) mprisPlayers.delete(name)
+
+      refreshAudioStreams()
+    },
+  )
+}
+
+function _playerForApp(app) {
+  let identities = app ? _appAudioIdentity(app).identities : new Set()
+
+  for (let [busName, proxy] of mprisPlayers) {
+    if (proxy && identities.has(_mprisKey(busName))) return proxy
+  }
+
+  return null
+}
+
+function _playbackStatus(proxy) {
+  try {
+    let status = proxy.get_cached_property('PlaybackStatus')
+    return status ? status.unpack() : null
+  } catch (e) {
+    return null
+  }
+}
+
+function _mprisCall(proxy, method) {
+  try {
+    proxy.call(method, null, Gio.DBusCallFlags.NONE, -1, null, () => {})
+  } catch (e) {
+    logError(e, 'DTP mpris')
+  }
+}
