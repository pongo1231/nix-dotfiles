+
+// Stream <-> app attribution for the preview audio controls.
+//
+// Identity comes from `pw-dump`, volume/mute/mpris from Gvc and MPRIS. The two
+// representations of a playback stream are joined on the pulse stream index:
+// pipewire-pulse derives that index from the PipeWire object serial
+// (alloc_object() in module-protocol-pulse/manager.c), which pw-dump reports as
+// `object.serial`. Names are the only thing both sides share otherwise, and
+// they do not line up often enough: a Wine game advertises its *title* and
+// "wine-preloader", a Java game just "java".
+//
+// Which app a stream belongs to is resolved the way Plasma's task manager does
+// it (applets/taskmanager/qml/Task.qml + PulseAudio.qml), in this order:
+//
+//   1. portal app id -- a sandboxed app reports a pid from outside the
+//      namespace, so its pid is meaningless and the app id is authoritative;
+//   2. client pid, directly or through the process ancestors of either side.
+//      This is what makes Java runtimes, Wine/Proton, Steam's runtime
+//      wrappers and browser content processes work, none of which own the
+//      window they are playing for;
+//   3. stream name, but only while no task claimed that name through a pid,
+//      so a second instance of an app does not inherit the first one's
+//      streams (Plasma's pidMatches guard).
+//
+// Anything name-based is a last resort, never a first guess.
+
+const OUTPUT_CLASS = 'Stream/Output/Audio'
+
+// .desktop suffixes never appear on stream properties and do appear on shell
+// app ids, so both sides are reduced to the same shape.
+function _norm(value) {
+  return String(value || '')
+    .toLowerCase()
+    .replace(/\.desktop$/, '')
+}
+
+function _identities(props) {
+  // application.name only. application.process.binary is shared by construction
+  // -- every Wine process reports "wine-preloader", every JDK "java" -- so
+  // matching on it would attribute one app's streams to another app of the same
+  // kind, and would also defeat the pidMatchedNames guard below.
+  let identities = new Set()
+
+  let appName = _norm(props['application.name'])
+  if (appName) identities.add(appName)
+
+  return identities
+}
+
+/**
+ * @param {string} text output of `pw-dump`
+ * @returns {Map<number, object>|null} pulse stream index -> stream, or null when
+ *   the dump could not be parsed (pw-dump missing, killed, truncated)
+ */
+export function parsePipewireDump(text) {
+  let objects
+
+  try {
+    objects = JSON.parse(text)
+  } catch (e) {
+    return null
+  }
+
+  if (!Array.isArray(objects)) return null
+
+  let clients = new Map()
+  for (let object of objects) {
+    if (object.type === 'PipeWire:Interface:Client' && object.info?.props)
+      clients.set(object.id, object.info.props)
+  }
+
+  let nodes = new Map()
+  for (let object of objects) {
+    if (object.type !== 'PipeWire:Interface:Node') continue
+
+    let info = object.info
+    if (info?.props?.['media.class'] !== OUTPUT_CLASS) continue
+
+    let index = Number(info.props['object.serial'])
+    if (!Number.isSafeInteger(index)) continue
+
+    // libpipewire fills the application properties on the node too, but the
+    // client carries the pid and portal id, and pipewire-pulse does not always
+    // copy those down.
+    let props = { ...info.props, ...(clients.get(info.props['client.id']) || {}) }
+
+    nodes.set(index, {
+      index,
+      // Gvc reports Gvc.MixerStreamState.INVALID for these streams, so the
+      // PipeWire node state is the only usable "is it playing" signal.
+      playing: info.state === 'running',
+      pid: Number(props['application.process.id']) || 0,
+      appId: _norm(props['pipewire.access.portal.app_id']),
+      identities: _identities(props),
+    })
+  }
+
+  return nodes
+}
+
+/**
+ * @param {Map<number, object>} nodes from parsePipewireDump()
+ * @param {{appId: string, pids: number[], identities: Set<string>}} app
+ * @param {object} context
+ * @param {(pid: number) => Set<number>} context.ancestorsOf pid plus its
+ *   ancestors; resolved by the caller from /proc
+ * @param {Set<string>} context.pidMatchedNames app identities already claimed
+ *   by a pid match; shared across all callers
+ * @returns {object[]} streams owned by app (both playing and idle)
+ */
+export function findNodesForApp(nodes, app, { ancestorsOf, pidMatchedNames }) {
+  let cache = new Map()
+  let ancestorsFor = pid => {
+    if (!cache.has(pid)) cache.set(pid, ancestorsOf(pid))
+    return cache.get(pid)
+  }
+
+  let appPids = new Set((app.pids || []).filter(pid => pid > 0))
+  let identities = app.identities || new Set()
+
+  if (app.appId) {
+    let matched = [...nodes.values()].filter(node => node.appId === app.appId)
+    if (matched.length) return matched
+  }
+
+  if (appPids.size) {
+    let matched = [...nodes.values()].filter(node => {
+      // A sandboxed stream's pid belongs to the sandbox namespace.
+      if (!node.pid || node.appId) return false
+      if (appPids.has(node.pid)) return true
+
+      // The stream comes from a helper below the app's process: Wine's audio
+      // thread, a JVM started by a launcher, a browser's content process.
+      for (let ancestor of ancestorsFor(node.pid))
+        if (ancestor !== node.pid && appPids.has(ancestor)) return true
+
+      // The stream comes from a process the app itself was started from:
+      // Steam's own runtime playgrounding a game, a shell wrapper.
+      for (let pid of appPids)
+        if (ancestorsFor(pid).has(node.pid)) return true
+
+      return false
+    })
+
+    if (matched.length) {
+      for (let identity of identities) pidMatchedNames.add(identity)
+      return matched
+    }
+  }
+
+  // Another task already owns this name through a pid; do not steal its
+  // streams just because the names happen to match.
+  for (let identity of identities) if (pidMatchedNames.has(identity)) return []
+
+  return [...nodes.values()].filter(node => {
+    for (let identity of identities)
+      if (node.identities.has(identity)) return true
+
+    return false
+  })
+}
